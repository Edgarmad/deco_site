{
  "name": "deco-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "supabase:setup": "node scripts/setup-supabase-cms.mjs",
    "supabase:setup:no-images": "node scripts/setup-supabase-cms.mjs --skip-images",
    "supabase:push": "supabase db push",
    "supabase:seed:inventory": "node scripts/seed-supabase-inventory.mjs",
    "supabase:migrate:product-data": "python scripts/migrate-product-technical-data.py",
    "supabase:upload:product-images": "node scripts/upload-product-images-to-supabase.mjs",
    "supabase:transparent:black": "node scripts/replace-black-background-product-images.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/vercel": "^11.0.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "astro": "^7.3.3",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.4": true
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
