---
type LocationItem = {
  number: string;
  slug: string;
  name: string;
  city: string;
  type: string;
  address: string;
  mapsUrl: string;
  contact: string;
};

type Props = {
  locations: LocationItem[];
};

const { locations } = Astro.props;
---

<!-- Seccion: Ubicaciones destacadas -->
<section id="ubicaciones" class="dark-section locations-section" data-reveal-group>
  <div class="location-list">
    {locations.map(({ number, slug, name, city, type, address, mapsUrl, contact }) => (
      <article class="location-row motion-row motion-location" data-reveal>
        <span class="row-number">{number}</span>
        <h2>{name}</h2>
        <a class={type === 'Tienda' ? 'tag filled' : 'tag'} href={mapsUrl} target="_blank" rel="noreferrer">Ubicación</a>
        <p>
          {address}
          {contact && <span class="location-contact">Contacto: {contact}</span>}
        </p>
        <a class="round-button dark motion-row__arrow" href={`/ubicaciones?ubicacion=${slug}`} aria-label={`Ver agentes de venta en ${city}`}>→</a>
      </article>
    ))}
  </div>
</section>
