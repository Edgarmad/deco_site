---
type Category = {
  name: string;
  slug: string;
  macroCategory: string;
  count: string;
  description: string;
};

type Props = {
  categories: Category[];
};

const { categories } = Astro.props;
---

<!-- Seccion: Compra por categoria -->
<section id="productos" class="section categories-section" data-reveal-group>
  <div class="section-head" data-reveal>
    <a href="/productos?categoria=interior">Compra por categoría</a>
    <span>30 productos en línea</span>
  </div>
  <div class="category-list">
    {categories.map((category) => (
      <article class="category-row motion-row" data-reveal>
        <div class="category-content">
          <div class="row-meta">
            <strong>{category.count}</strong>
            <p>{category.description}</p>
          </div>
          <h2>{category.name}</h2>
        </div>
        <a class="round-button motion-row__arrow" href={`/productos?categoria=${category.macroCategory}`} aria-label={`Ver ${category.name}`}>→</a>
      </article>
    ))}
  </div>
</section>
