---
type PopularProduct = {
  name: string;
  slug: string;
  category: string;
  image?: string;
};

type Props = {
  products: PopularProduct[];
};

const { products } = Astro.props;
const marqueeProducts = [...products, ...products];
---

<!-- Seccion: Productos populares -->
<section class="section popular-section" data-reveal-group aria-labelledby="popular-title">
  <h2 id="popular-title" class="visually-hidden">Productos populares</h2>
  <div class="popular-marquee motion-marquee">
    <div class="motion-marquee__track">
      {marqueeProducts.map((product, index) => {
        const isDuplicate = index >= products.length;
        return (
          <article class="popular-product-card" aria-hidden={isDuplicate ? 'true' : undefined}>
            <a class="popular-product-media" href={`/productos/${product.slug}`} tabindex={isDuplicate ? '-1' : undefined} aria-hidden={isDuplicate ? 'true' : undefined}>
            <div class={`popular-product-visual popular-product-visual-${(index % 7) + 1}`}>
              {product.image ? <img src={product.image} alt="" loading="lazy" /> : <span></span>}
            </div>
            </a>
            <a class="popular-product-copy" href={`/productos/${product.slug}`} tabindex={isDuplicate ? '-1' : undefined} aria-hidden={isDuplicate ? 'true' : undefined}>
              <span>{product.name}</span>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</section>
