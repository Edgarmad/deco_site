---
type LocationItem = {
  number: string;
  city: string;
  type: string;
  address: string;
  schedule: string;
  mapsUrl: string;
};

type Props = {
  locations: LocationItem[];
  whatsappUrl: string;
};

const { locations, whatsappUrl } = Astro.props;
---

<main class="locations-page">
  <!-- Seccion: Hero de ubicaciones -->
  <section class="locations-hero" aria-labelledby="locations-title">
    <p>Red Deco ABC</p>
    <h1 id="locations-title">Visítanos cerca <span>de tu proyecto.</span></h1>
    <small>{locations.length} ubicaciones · atención directa</small>
  </section>

  <!-- Seccion: Lista de ubicaciones -->
  <section class="locations-list" aria-label="Sucursales Deco ABC">
    {locations.map((location) => (
      <article class="location-card">
        <span>{location.number}</span>
        <h2>{location.city}</h2>
        <strong>{location.type}</strong>
        <div>
          <p>{location.address}</p>
          <small>{location.schedule}</small>
        </div>
        <a href={location.mapsUrl} target="_blank" rel="noreferrer">Abrir en maps ↗</a>
      </article>
    ))}
  </section>

  <!-- Seccion: Confirmacion por WhatsApp -->
  <section class="locations-cta" aria-label="Confirmar existencias">
    <h2>¿Necesitas confirmar existencias antes de visitarnos?</h2>
    <a href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp →</a>
  </section>
</main>

<style>
  .locations-page {
    min-height: 100vh;
    padding: 70px 6.6vw 74px;
    background: var(--black);
    color: var(--white);
  }

  .locations-hero p,
  .location-card span,
  .location-card strong {
    margin: 0;
    color: var(--green);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .locations-hero h1 {
    max-width: 650px;
    margin: 26px 0 22px;
    font-size: clamp(3.5rem, 6vw, 6.4rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .locations-hero h1 span {
    display: block;
    color: var(--green);
  }

  .locations-hero small {
    color: #8f948e;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .locations-list {
    margin-top: 44px;
    border-top: 1px solid var(--line);
  }

  .location-card {
    display: grid;
    grid-template-columns: 58px minmax(230px, 1fr) 110px minmax(320px, 1.2fr) 180px;
    gap: 34px;
    align-items: start;
    padding: 34px 0 70px;
    border-bottom: 1px solid var(--line);
  }

  .location-card h2 {
    margin: 0;
    font-size: clamp(2rem, 3vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .location-card p {
    margin: 0 0 34px;
    color: #9ca19a;
    line-height: 1.5;
  }

  .location-card small {
    color: #c2c6bf;
    font-size: 0.74rem;
    text-transform: uppercase;
  }

  .location-card a,
  .locations-cta a {
    display: inline-grid;
    place-items: center;
    min-height: 62px;
    padding: 0 26px;
    border: 1px solid var(--green);
    color: var(--white);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .locations-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    margin-top: 48px;
    padding: 22px 28px;
    background: var(--blue-deep);
  }

  .locations-cta h2 {
    margin: 0;
    font-size: clamp(1.2rem, 1.8vw, 2rem);
  }

  .locations-cta a {
    min-width: 200px;
    border-color: var(--green);
    background: var(--green);
  }

  @media (max-width: 860px) {
    .locations-page {
      padding: 42px 14px 28px;
    }

    .locations-hero h1 {
      font-size: 2.35rem;
      line-height: 1.08;
    }

    .locations-list {
      display: grid;
      gap: 24px;
      margin-top: 26px;
      border-top: 0;
    }

    .location-card {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 24px 18px 18px;
      border: 1px solid var(--line);
      border-radius: 5px;
      background: rgba(255, 255, 255, 0.03);
    }

    .location-card h2 {
      font-size: 1.5rem;
    }

    .location-card p {
      margin-bottom: 0;
      font-size: 0.82rem;
    }

    .location-card small,
    .location-card strong {
      display: none;
    }

    .location-card a {
      min-height: 42px;
      margin-top: 6px;
    }

    .locations-cta {
      display: grid;
      margin-top: 32px;
      padding: 24px 18px;
    }

    .locations-cta a {
      min-width: 0;
      min-height: auto;
      place-items: start;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--green);
    }
  }
</style>
