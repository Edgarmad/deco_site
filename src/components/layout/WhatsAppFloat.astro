---
import { getWhatsappUrl } from '../../services/siteSettingsService';

const whatsappUrl = await getWhatsappUrl();
---

<div class="whatsapp-widget">
  <section class="whatsapp-card" id="whatsapp-card" aria-labelledby="whatsapp-card-title">
    <div class="whatsapp-card-header">
      <span class="whatsapp-avatar" aria-hidden="true">D</span>
      <div class="whatsapp-card-heading">
        <h2 id="whatsapp-card-title">DECO ABC</h2>
        <p>Estamos listos para ayudarte</p>
      </div>
      <button class="whatsapp-close" type="button" aria-label="Cerrar ventana de WhatsApp">&times;</button>
    </div>
    <div class="whatsapp-card-body">
      <div class="whatsapp-message">
        <strong>¡Hola! Soy Felipe, la IA de DecoABC.</strong>
        <p>¿Cómo podría ayudarte hoy?</p>
      </div>
      <a class="whatsapp-chat" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Iniciar chat en WhatsApp</a>
    </div>
  </section>
  <button class="whatsapp-float" type="button" aria-label="Abrir ventana de WhatsApp" aria-controls="whatsapp-card" aria-expanded="true">
    <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <path d="M16 3.5a12.25 12.25 0 0 0-10.6 18.4L4 28l6.3-1.3A12.25 12.25 0 1 0 16 3.5Zm0 22.3a10 10 0 0 1-5.1-1.4l-.4-.2-3.7.8.8-3.6-.3-.4A10 10 0 1 1 16 25.8Zm5.5-7.4c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-.9 1.2-.3.3-.6.1a8.2 8.2 0 0 1-2.4-1.5 9 9 0 0 1-1.7-2.1c-.2-.3 0-.5.2-.7l.5-.6.2-.5-.1-.5c-.1-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4a3.2 3.2 0 0 0-1 2.4c0 1.4 1 2.8 1.1 3 .2.2 2 3.1 4.8 4.4.7.3 1.2.5 1.6.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4Z"></path>
    </svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.whatsapp-widget').forEach((widget) => {
    const card = widget.querySelector<HTMLElement>('.whatsapp-card');
    const close = widget.querySelector<HTMLButtonElement>('.whatsapp-close');
    const launcher = widget.querySelector<HTMLButtonElement>('.whatsapp-float');
    if (!card || !close || !launcher) return;

    close.addEventListener('click', () => {
      card.hidden = true;
      launcher.setAttribute('aria-expanded', 'false');
      launcher.focus();
    });
    launcher.addEventListener('click', () => {
      card.hidden = false;
      launcher.setAttribute('aria-expanded', 'true');
      close.focus();
    });
  });
</script>

<style>
  .whatsapp-widget {
    position: fixed;
    right: 24px;
    bottom: 24px;
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    font-family: Arial, ui-sans-serif, system-ui, sans-serif;
    text-transform: none;
  }

  .whatsapp-card {
    display: flex;
    flex-direction: column;
    width: min(380px, calc(100vw - 48px));
    max-height: calc(100vh - 190px);
    max-height: calc(100dvh - 190px - env(safe-area-inset-bottom, 0px));
    overflow: hidden;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 8px 0 rgb(255 255 255 / 55%), 0 18px 40px rgb(0 0 0 / 22%);
    color: #1e2225;
  }

  .whatsapp-card[hidden] { display: none; }

  .whatsapp-card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: none;
    padding: 20px;
    background: #193d60;
    color: #fff;
  }

  .whatsapp-avatar {
    display: grid;
    place-items: center;
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #fff;
    color: #193d60;
    font-size: 26px;
    font-weight: 800;
  }

  .whatsapp-card-heading { min-width: 0; }
  .whatsapp-card-heading h2 { margin: 0 0 4px; font-size: 18px; line-height: 1.2; }
  .whatsapp-card-heading p { margin: 0; font-size: 13px; line-height: 1.35; color: #e0e7ed; }

  .whatsapp-close {
    align-self: flex-start;
    margin: -5px -7px 0 auto;
    padding: 2px 7px;
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
    font-size: 30px;
    line-height: 1;
  }

  .whatsapp-card-body {
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-height: 0;
    overflow-y: auto;
    padding: 22px 20px 24px;
  }

  .whatsapp-message { padding: 18px 16px; border-radius: 12px; background: #f6f5f3; }
  .whatsapp-message strong { font-size: 16px; line-height: 1.4; }
  .whatsapp-message p { margin: 10px 0 0; color: #626a6b; font-size: 14px; line-height: 1.5; }

  .whatsapp-chat {
    display: block;
    padding: 16px 12px;
    border-radius: 8px;
    background: #16834e;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    text-align: center;
  }

  .whatsapp-chat:hover, .whatsapp-chat:focus-visible { background: #106c3a; }
  .whatsapp-close:focus-visible, .whatsapp-chat:focus-visible { outline: 2px solid #193d60; outline-offset: 2px; }

  .whatsapp-float {
    display: inline-grid;
    align-items: center;
    gap: 12px;
    place-items: center;
    width: 58px;
    height: 58px;
    min-width: 58px;
    min-height: 58px;
    aspect-ratio: 1;
    flex: 0 0 58px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #168c4b;
    box-shadow: 0 12px 30px rgb(0 0 0 / 22%);
    color: #fff;
    cursor: pointer;
    transition: transform 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
  }

  .whatsapp-float:hover,
  .whatsapp-float:focus-visible {
    background: #106c3a;
    box-shadow: 0 16px 34px rgb(0 0 0 / 28%);
    transform: translateY(-2px);
  }

  .whatsapp-float:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .whatsapp-float svg {
    width: 29px;
    height: 29px;
    fill: currentColor;
  }

  @media (max-width: 640px) {
    .whatsapp-widget {
      right: 16px;
      bottom: 16px;
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    }

    .whatsapp-card {
      width: min(340px, calc(100vw - 32px));
      max-height: calc(100vh - 148px);
      max-height: calc(100dvh - 148px - env(safe-area-inset-bottom, 0px));
    }

    .whatsapp-float {
      width: 48px;
      height: 48px;
      min-width: 48px;
      min-height: 48px;
      flex-basis: 48px;
    }

    .whatsapp-float svg {
      width: 25px;
      height: 25px;
    }
  }
</style>
