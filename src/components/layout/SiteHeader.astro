---
import { getLocations } from '../../services/locationService';
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Interior', href: '/productos?categoria=interior' },
  { label: 'Exterior', href: '/productos?categoria=exterior' },
  { label: 'Contáctanos', href: '/contacto' }
];
const catalogLocations = await getLocations();

const isActive = (href: string) => currentPath === href.split('?')[0];
const isProductsActive = isActive('/productos');
---

<!-- Seccion: Header / Navegacion principal -->
<header class="site-header" data-motion-header>
  <div class="nav-shell catalog-nav-shell">
    <a class="brand" href="/" aria-label="Deco inicio">
      <img src="/assets/photos/deco_abc_logo.png" alt="Deco ABC" />
    </a>
    <nav class="desktop-nav" aria-label="Navegacion principal">
      <a class:list={[isActive('/') && 'active', 'motion-nav-link']} href="/" aria-current={isActive('/') ? 'page' : undefined}>Inicio</a>
      <a class:list={[isProductsActive && 'active', 'motion-nav-link']} href="/productos?categoria=interior">Interior</a>
      <a class:list={[isProductsActive && 'active', 'motion-nav-link']} href="/productos?categoria=exterior">Exterior</a>
      <div class="catalog-menu">
        <button class="motion-nav-link" type="button" aria-haspopup="true">Catálogo</button>
        <div class="catalog-submenu" role="menu">
          {catalogLocations.map((location) => <a href={location.catalogUrl} target={location.catalogUrl ? '_blank' : undefined} rel={location.catalogUrl ? 'noreferrer' : undefined} role="menuitem">{location.name}</a>)}
        </div>
      </div>
      <a class:list={[isActive('/contacto') && 'active', 'motion-nav-link']} href="/contacto" aria-current={isActive('/contacto') ? 'page' : undefined}>Contáctanos</a>
    </nav>
    <a class:list={['search-link', isActive('/busqueda') && 'active']} href="/busqueda" aria-label="Buscar" aria-current={isActive('/busqueda') ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="10.8" cy="10.8" r="6.6"></circle>
        <path d="m16 16 5 5"></path>
      </svg>
    </a>
    <button class="mobile-menu-button" type="button" data-mobile-menu-button aria-expanded="false">Menu</button>
  </div>
  <nav class="mobile-menu" data-mobile-menu data-motion-menu hidden aria-label="Navegacion movil">
    {navItems.slice(0, 3).map((item) => <a class:list={[isActive(item.href) && 'active', 'motion-nav-link']} data-motion-menu-item href={item.href}>{item.label}</a>)}
    <details class="mobile-catalog-menu">
      <summary>Catálogo</summary>
      {catalogLocations.map((location) => <a data-motion-menu-item href={location.catalogUrl} target={location.catalogUrl ? '_blank' : undefined} rel={location.catalogUrl ? 'noreferrer' : undefined}>{location.name}</a>)}
    </details>
    <a class:list={[isActive('/contacto') && 'active', 'motion-nav-link']} data-motion-menu-item href="/contacto">Contáctanos</a>
  </nav>
</header>

<script>
  const menuButton = document.querySelector('[data-mobile-menu-button]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');

  if (menuButton instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement) {
    menuButton.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isOpen));
      mobileMenu.hidden = isOpen;
    });
  }
</script>

<style>
  .desktop-nav a.active,
  .desktop-nav button.active,
  .mobile-menu a.active {
    color: var(--black);
  }

  .catalog-menu {
    position: relative;
  }

  .catalog-menu::before {
    content: '|';
    margin-right: 22px;
    color: rgba(20, 21, 18, 0.8);
  }

  .catalog-menu button {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
  }

  .catalog-submenu {
    position: absolute;
    top: 100%;
    left: 22px;
    min-width: 210px;
    display: grid;
    gap: 10px;
    padding: 28px 14px 14px;
    background: linear-gradient(to bottom, transparent 0 14px, var(--white-pure) 14px);
    border: 1px solid transparent;
    border-bottom-color: var(--paper-line);
    box-shadow: 0 18px 36px rgb(0 0 0 / 12%);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity var(--motion-fast) var(--motion-ease-ui), transform var(--motion-fast) var(--motion-ease-ui);
  }

  .catalog-menu:hover .catalog-submenu,
  .catalog-menu:focus-within .catalog-submenu {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .catalog-submenu a {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
  }

  .catalog-submenu a + a::before {
    content: none;
    margin: 0;
  }

  .catalog-menu + a::before {
    content: '|';
    margin-right: 22px;
    color: rgba(20, 21, 18, 0.8);
  }

  .mobile-menu-button,
  .mobile-menu {
    display: none;
  }

  .search-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    margin-left: 8px;
    width: 28px;
    height: 28px;
    color: var(--black);
  }

  .search-link svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  .search-link:hover,
  .search-link:focus-visible,
  .search-link.active {
    color: var(--blue);
  }

  .search-link:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  @media (max-width: 1000px) {
    .catalog-nav-shell {
      min-height: 70px;
    }

    .mobile-menu-button {
      display: inline-grid;
      padding: 10px 14px;
      border: 1px solid rgba(20, 21, 18, 0.2);
      background: transparent;
      color: var(--black);
      font: inherit;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .search-link {
      margin-left: auto;
    }

    .mobile-menu:not([hidden]) {
      display: grid;
      gap: 14px;
      padding: 18px 24px 24px;
      background: var(--white);
      color: var(--black);
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .mobile-catalog-menu {
      display: grid;
      gap: 12px;
    }

    .mobile-catalog-menu summary {
      cursor: pointer;
      list-style: none;
    }

    .mobile-catalog-menu summary::-webkit-details-marker {
      display: none;
    }

    .mobile-catalog-menu a {
      display: block;
      padding-left: 16px;
      color: var(--blue);
    }
  }
</style>
