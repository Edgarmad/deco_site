---
import type { Product, ProductCategory } from '../../types/products';
import type { ProductSectionVisibility } from '../../services/siteSettingsService';
import ProductCalculator from './ProductCalculator.astro';

type Props = {
  product: Product;
  categories: ProductCategory[];
  products: Product[];
  sectionVisibility: ProductSectionVisibility;
};

const { product, categories, products, sectionVisibility } = Astro.props;
const visibility = {
  ...sectionVisibility,
  ...product.sectionVisibility
};
const specs = product.technicalSpecs ?? {};
const formattedPrice = product.price != null ? `$${product.price.toFixed(2)}` : undefined;
const priceUnit = product.variants[0]?.pricePresentation === 'Caja' ? 'caja' : product.variants[0]?.pricePresentation === 'Pieza' ? 'pieza' : undefined;
const technicalRows = [
  ['Dimensiones', product.dimensions ? `${product.dimensions}${product.thickness ? ` · Espesor: ${product.thickness}` : ''}` : undefined],
  ['Material', product.material],
  ['Uso recomendado', product.usage],
  ['Peso', specs.weight],
  ['Presentación', specs.presentation],
  ['Cobertura', specs.coverage],
  ['Resistencia al agua', specs.water_resistance],
  ['Clasificación de fuego', specs.fire_classification]
].filter(([, value]) => value != null && value !== '');
const category = categories.find((item) => item.slug === product.categorySlug);
const currentVariant = product.variants[0];
const currentVariantKey = currentVariant?.id ?? (currentVariant ? `${product.categorySlug}:${currentVariant.slug}` : undefined);
const siblingProducts = products.filter((item) => item.categorySlug === product.categorySlug);
const variantSiblingProducts = currentVariantKey
  ? siblingProducts.filter((item) => {
      const itemVariant = item.variants[0];
      const itemVariantKey = itemVariant?.id ?? (itemVariant ? `${item.categorySlug}:${itemVariant.slug}` : undefined);
      return itemVariantKey === currentVariantKey;
    })
  : siblingProducts;
const relatedProducts = siblingProducts.filter((item) => item.slug !== product.slug).slice(0, 3);
const allColors = product.variants.flatMap((variant) => variant.colors);
const activeTone = allColors[0];
const variantItems = variantSiblingProducts.length > 0 ? variantSiblingProducts : [product];
const faqItems = Object.entries(product.faqItems ?? {});
const installationSteps = (product.installationNotes ?? '').split(/\r?\n/).filter(Boolean);
const galleryImages = product.galleryImages ?? (product.gallery ?? []).map(url => ({ url, alt: product.name }));
const supportFiles = product.supportFiles ?? [];
const catalogUrl = `/productos?categoria=${product.macroCategory === 'exterior' ? 'exterior' : 'interior'}`;
---

<main>
  <!-- Seccion: Detalle de producto -->
  <section class="product-detail" data-reveal-group>
    <a class="back-link" href={catalogUrl}>Volver al catalogo</a>
    <div class="detail-layout">
       <div class="detail-media motion-card__media" data-product-gallery>
         <div class="detail-main-image">
           {product.image ? <img class="motion-product-image" src={product.image} alt={product.imageAlt ?? product.name} /> : <span class="motion-product-image" aria-hidden="true"></span>}
         </div>
         {galleryImages.length > 0 && <div class="cms-product-gallery">{galleryImages.map(image => <a href={image.url} target="_blank" rel="noreferrer"><img src={image.url} alt={image.alt} loading="lazy" /></a>)}</div>}
       </div>
      <article class="detail-copy" data-reveal-group>
        <p data-reveal>{product.categoryName ?? category?.name ?? product.macroCategory}</p>
        <h1 data-reveal>{product.name}</h1>
        {product.sku && <strong data-reveal>SKU: {product.sku}</strong>}
        <div class="summary" data-reveal>{product.summary ?? 'Producto Deco en preparacion para publicacion final.'}</div>
        {formattedPrice && <div class="wholesale-price" data-reveal>
          <span class="wholesale-price-label">Precio de mayoreo</span>
          <div class="wholesale-price-value"><strong>{formattedPrice}</strong>{priceUnit && <span>por {priceUnit}</span>}</div>
        </div>}
        <div class="detail-block" data-reveal>
          <h2>Colores de esta familia</h2>
           <div class="tone-navigation" data-tone-navigation>
             <button class="tone-arrow" type="button" data-tone-direction="-1" aria-label="Ver colores anteriores" aria-controls="product-tone-selector">←</button>
             <div class="tone-selector" id="product-tone-selector" role="group" aria-label="Variantes disponibles">
              <div class="tone-selector-track">
               {variantItems.map((variantProduct, index) => (
                 <a class={variantProduct.slug === product.slug ? 'active' : ''} href={`/productos/${variantProduct.slug}`} aria-current={variantProduct.slug === product.slug ? 'page' : undefined} title={variantProduct.name}>
                    <span class={`tone-dot${variantProduct.image ? ' tone-dot-image' : ` tone-dot-${(index % 8) + 1}`}`} style={!variantProduct.image && variantProduct.variants[0]?.colors[0]?.hex ? { background: variantProduct.variants[0].colors[0].hex } : undefined} aria-hidden="true">
                     {variantProduct.image && <img src={variantProduct.image} alt="" loading="lazy" />}
                   </span>
                   <small>{variantProduct.variants[0]?.colors[0]?.name ?? variantProduct.name}</small>
                 </a>
               ))}
              </div>
             </div>
             <button class="tone-arrow" type="button" data-tone-direction="1" aria-label="Ver más colores" aria-controls="product-tone-selector">→</button>
            </div>
        </div>
        <div class="detail-block" data-reveal>
          <h2>Datos comerciales</h2>
           <div class="chips">
             <small>{activeTone?.name ?? 'Acabado por confirmar'}</small>
             <small>{product.macroCategory}</small>
             <small>{product.variants[0]?.name ?? 'Presentacion por confirmar'}</small>
              {product.finish && <small>{product.finish}</small>}
           </div>
         </div>
          {visibility.technical && technicalRows.length > 0 && <div class="product-specs" data-reveal>
           <p>Especificaciones del producto</p>
           <dl>
             {technicalRows.map(([label, value]) => (
               <div class="product-spec-row">
                 <dt>{label}</dt>
                 <dd>{value}</dd>
               </div>
             ))}
           </dl>
         </div>}
         <a class="quote-link motion-button" data-reveal href="/contacto">Solicitar cotizacion</a>
      </article>
    </div>
   </section>

  {product.calculator && <ProductCalculator config={product.calculator} productName={product.name} />}

   {(visibility.technical || visibility.support) && <section class="technical-section" data-reveal="section" aria-labelledby={visibility.technical ? 'technical-title' : 'support-title'}>
     {visibility.technical && <div class="technical-copy">
      <p>Informacion tecnica</p>
      <h2 id="technical-title">Especificacion, cuidados y soporte</h2>
       <details open>
         <summary>Descripcion</summary>
         <p>{product.description ?? product.summary ?? 'Revestimiento decorativo para proyectos residenciales y comerciales.'}</p>
      </details>
       <details>
         <summary>Dimensiones</summary>
         <p>{product.dimensions ?? 'Medidas por confirmar en ficha tecnica.'}{product.thickness ? ` · Espesor: ${product.thickness}` : ''}</p>
       </details>
       <details>
         <summary>Cuidados y garantia</summary>
         <p>{product.careNotes ?? 'Cuidados por confirmar.'}</p>
       </details>
     </div>}
       {visibility.support && <aside class="support-card">
        <h2 id="support-title">Material de apoyo</h2>
         {supportFiles.map((file) => <div class="support-file">
           <h3>{file.title}</h3>
           {(file.mimeType === 'application/pdf' || file.originalFilename?.toLowerCase().endsWith('.pdf')) && <iframe
             class="support-preview"
             src={`${file.url}#page=1&toolbar=0&navpanes=0&view=FitH`}
             title={`Vista previa de ${file.title}`}
             loading="lazy"
           ></iframe>}
           <a class="support-download" href={file.url} download={file.originalFilename} target="_blank" rel="noreferrer">Descargar {file.title}</a>
         </div>)}
         {!supportFiles.length && <p class="support-empty">No hay archivos de apoyo disponibles por ahora.</p>}
      </aside>}
   </section>}

   {(visibility.faq || visibility.installation) && <section class="faq-installation" data-reveal-group>
      {visibility.faq && faqItems.length > 0 && <div class="faq-list">
      <h2>Preguntas frecuentes</h2>
      {faqItems.map(([question, answer]) => (
        <details class="motion-accordion" data-reveal>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
     </div>}
      {visibility.installation && installationSteps.length > 0 && <div class="installation-list">
      <h2>Guia de instalacion</h2>
       {installationSteps.map((step, index) => (
        <p data-reveal><span>{String(index + 1).padStart(2, '0')}</span>{step}</p>
      ))}
     </div>}
   </section>}

  <!-- Seccion: Productos relacionados -->
  <section class="related-section" data-reveal-group>
    <h2 data-reveal>Relacionados</h2>
    <div class="related-grid">
      {relatedProducts.length > 0 ? relatedProducts.map((item) => (
        <a class="motion-card" data-reveal href={`/productos/${item.slug}`}>
          <span>{item.macroCategory}</span>
          <strong>{item.name}</strong>
        </a>
      )) : <p>No hay relacionados disponibles por ahora.</p>}
    </div>
  </section>
</main>

<script>
  const navigation = document.querySelector<HTMLElement>('[data-tone-navigation]');
  const selector = navigation?.querySelector<HTMLElement>('.tone-selector');
  const previous = navigation?.querySelector<HTMLButtonElement>('[data-tone-direction="-1"]');
  const next = navigation?.querySelector<HTMLButtonElement>('[data-tone-direction="1"]');

  if (navigation && selector && previous && next) {
    const updateControls = () => {
      const maxScroll = selector.scrollWidth - selector.clientWidth;
      navigation.toggleAttribute('data-enhanced', maxScroll > 1);
      previous.disabled = selector.scrollLeft <= 1;
      next.disabled = selector.scrollLeft >= maxScroll - 1;
    };

    const scrollVariants = (direction: number) => {
      const firstVariant = selector.querySelector<HTMLElement>('.tone-selector-track a');
      const track = selector.querySelector<HTMLElement>('.tone-selector-track');
      const gap = track ? parseFloat(getComputedStyle(track).columnGap) || 0 : 0;
      selector.scrollBy({ left: direction * ((firstVariant?.offsetWidth ?? selector.clientWidth) + gap), behavior: 'smooth' });
    };

    previous.addEventListener('click', () => scrollVariants(-1));
    next.addEventListener('click', () => scrollVariants(1));
    selector.addEventListener('scroll', updateControls, { passive: true });
    new ResizeObserver(updateControls).observe(selector);
    updateControls();
  }
</script>

<style>
  .detail-main-image {
    width: 100%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: #f0f0ec;
    overflow: hidden;
  }

  .cms-product-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 12px;
  }

  .cms-product-gallery a {
    display: block;
    aspect-ratio: 1.25;
    background: #f0f0ec;
    overflow: hidden;
  }

  .cms-product-gallery img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .product-detail {
    padding: 64px 8vw 78px;
    background: var(--white-pure);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: #677067;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .back-link::before {
    content: '← ';
  }

  .detail-layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 58px;
    align-items: start;
  }

  .detail-media {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 0;
    overflow: hidden;
  }

  .detail-copy {
    min-width: 0;
  }

  .detail-main-image img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .detail-main-image span {
    width: 52%;
    height: 64%;
    transform: perspective(640px) rotateX(56deg) rotateZ(-22deg);
    background: repeating-linear-gradient(90deg, #7a4f2c 0 22px, #c69055 22px 38px, #2b2018 38px 46px);
    box-shadow: 18px 28px 40px rgba(0, 0, 0, 0.22);
  }

  .detail-copy p {
    margin: 0 0 18px;
    color: var(--green-text);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .detail-copy h1 {
    margin: 0 0 20px;
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .detail-copy strong {
    display: block;
    margin-bottom: 22px;
    color: #677067;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
  }

  .summary {
    max-width: 560px;
    color: #596059;
    line-height: 1.7;
  }

  .wholesale-price {
    margin-top: 20px;
    padding: 18px 22px;
    border-left: 4px solid var(--green);
    background: #f0f6f0;
  }

  .wholesale-price-label {
    color: var(--green-text);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .wholesale-price-value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-top: 5px;
    color: var(--green-text);
    font-size: 1rem;
    font-weight: 700;
  }

  .detail-copy .wholesale-price-value strong {
    display: inline;
    margin: 0;
    color: inherit;
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: normal;
  }

  .detail-block {
    margin-top: 30px;
  }

  .detail-block h2,
  .related-section h2 {
    margin: 0 0 14px;
    color: #818781;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tone-navigation {
    position: relative;
    min-width: 0;
  }

  .tone-selector {
    width: 100%;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: #c5cac3 transparent;
  }

  .tone-navigation[data-enhanced] .tone-selector {
    scrollbar-width: none;
  }

  .tone-navigation[data-enhanced] .tone-selector::-webkit-scrollbar {
    display: none;
  }

  .tone-arrow {
    display: none;
    width: 36px;
    height: 36px;
    position: absolute;
    z-index: 1;
    top: 50%;
    transform: translateY(-50%);
    place-items: center;
    border: 1px solid #d4d8d2;
    border-radius: 50%;
    background: var(--white-pure);
    color: var(--green-text);
    cursor: pointer;
    font-size: 1.2rem;
  }

  .tone-arrow[data-tone-direction="-1"] {
    left: 0;
  }

  .tone-arrow[data-tone-direction="1"] {
    right: 0;
  }

  .tone-navigation[data-enhanced] .tone-arrow {
    display: grid;
  }

  .tone-arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .tone-arrow:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }

  .tone-selector-track {
    width: max-content;
    display: flex;
    gap: 18px;
  }

  .tone-selector a {
    flex: 0 0 auto;
    display: grid;
    justify-items: center;
    gap: 8px;
    color: var(--black);
    font-size: 1.12rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tone-selector a.active {
    color: var(--green);
  }

  .tone-dot {
    width: 144px;
    height: 144px;
    display: block;
    position: relative;
    border-radius: 999px;
    border: 2px solid var(--white-pure);
    overflow: hidden;
  }

  .tone-dot-image {
    background: #f0f0ec;
  }

  .tone-dot-image img {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    display: block;
    object-fit: cover;
    object-position: center;
    transform: scale(5);
    transform-origin: center;
  }

  .tone-dot-1 { background: #8d5b32; }
  .tone-dot-2 { background: #c69055; }
  .tone-dot-3 { background: #b76f2f; }
  .tone-dot-4 { background: #6a442b; }
  .tone-dot-5 { background: #d8c6af; }
  .tone-dot-6 { background: #3d3833; }
  .tone-dot-7 { background: #a67b55; }
  .tone-dot-8 { background: #705f4f; }

  .chips small {
    padding: 8px 12px;
    border: 1px solid #d4d8d2;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-specs {
    margin-top: 34px;
  }

  .product-specs > p {
    margin: 0 0 12px;
    color: var(--green-text);
    font-size: calc(0.68rem + 2px);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .product-specs dl {
    margin: 0;
    border-top: 1px solid var(--black);
  }

  .product-spec-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 20px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--paper-line);
  }

  .product-spec-row dt {
    color: #737a73;
    font-size: calc(0.66rem + 2px);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-spec-row dd {
    margin: 0;
    color: var(--black);
    font-size: calc(0.82rem + 2px);
    font-weight: 700;
    text-align: right;
  }

  .quote-link {
    display: inline-block;
    margin-top: 38px;
    padding: 15px 22px;
    background: var(--blue);
    color: var(--white-pure);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .related-section {
    padding: 54px 8vw 82px;
    background: var(--white);
  }

  .quote-calculator,
  .technical-section,
  .faq-installation {
    padding: 54px 8vw;
    background: #ecedeb;
  }

  .quote-calculator {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(320px, 1.2fr);
    gap: 32px;
    align-items: end;
    border-top: 1px solid var(--paper-line);
  }

  .quote-calculator p,
  .technical-copy > p {
    margin: 0 0 10px;
    color: var(--green-text);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .quote-calculator h2,
  .technical-copy h2,
  .faq-list h2,
  .installation-list h2 {
    margin: 0 0 20px;
    font-size: clamp(1.8rem, 3.5vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .calculator-form {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .calculator-form label {
    color: #737a73;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .calculator-form input {
    width: 100%;
    margin-top: 8px;
    padding: 13px 12px;
    border: 1px solid #d2d5cf;
    background: var(--white-pure);
    color: var(--black);
  }

  .calculator-form a {
    display: grid;
    place-items: center;
    padding: 13px;
    background: var(--blue);
    color: var(--white-pure);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  .technical-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    background: var(--white-pure);
  }

  details {
    border-top: 1px solid var(--paper-line);
  }

  details:last-child {
    border-bottom: 1px solid var(--paper-line);
  }

  summary {
    padding: 18px 0;
    cursor: pointer;
    font-weight: 800;
    text-transform: uppercase;
  }

  details p {
    margin: 0 0 18px;
    color: #596059;
    line-height: 1.7;
  }

  .support-card {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 24px;
    background: #f3f3ef;
  }

  .support-card h2 {
    margin: 0 0 8px;
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .support-file {
    min-width: 0;
    display: grid;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--paper-line);
  }

  .support-file + .support-file {
    margin-top: 12px;
  }

  .support-file h3 {
    margin: 0;
    font-size: 0.9rem;
  }

  .support-preview {
    display: block;
    width: 100%;
    max-width: 900px;
    height: clamp(220px, 30vw, 360px);
    border: 1px solid var(--paper-line);
    background: var(--white-pure);
  }

  .support-card a {
    justify-self: start;
    padding: 13px 0;
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .support-empty {
    margin: 0;
    color: #596059;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .faq-installation {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
    gap: 42px;
  }

  .installation-list p {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 18px;
    margin: 0;
    padding: 15px 0;
    border-bottom: 1px solid var(--paper-line);
    color: #596059;
    font-weight: 700;
  }

  .installation-list span {
    color: var(--blue);
    font-weight: 800;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .related-grid a {
    min-height: 150px;
    display: grid;
    align-content: end;
    gap: 10px;
    padding: 22px;
    background: var(--white-pure);
    border: 1px solid var(--paper-line);
  }

  .related-grid span {
    color: var(--green-text);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .related-grid strong {
    font-size: 1.2rem;
