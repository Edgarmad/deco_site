---
import type { Product, ProductCategory } from '../../types/products';
import type { ProductSectionVisibility } from '../../services/siteSettingsService';

type Props = {
  product: Product;
  categories: ProductCategory[];
  products: Product[];
  sectionVisibility: ProductSectionVisibility;
};

const { product, categories, products, sectionVisibility } = Astro.props;
const visibility = {
  ...sectionVisibility,
  ...product.sectionVisibility
};
const specs = product.technicalSpecs ?? {};
const technicalRows = [
  ['Dimensiones', product.dimensions ? `${product.dimensions}${product.thickness ? ` · Espesor: ${product.thickness}` : ''}` : undefined],
  ['Material', product.material],
  ['Uso recomendado', product.usage],
  ['Peso', specs.weight],
  ['Presentación', specs.presentation],
  ['Piezas por caja', specs.pieces_per_box],
  ['Cobertura', specs.coverage],
  ['Resistencia al agua', specs.water_resistance],
  ['Clasificación de fuego', specs.fire_classification]
].filter(([, value]) => value != null && value !== '');
const category = categories.find((item) => item.slug === product.categorySlug);
const siblingProducts = products.filter((item) => item.categorySlug === product.categorySlug);
const relatedProducts = siblingProducts.filter((item) => item.slug !== product.slug).slice(0, 3);
const allColors = product.variants.flatMap((variant) => variant.colors);
const activeTone = allColors[0];
const variantItems = siblingProducts.length > 0 ? siblingProducts : [product];
const faqItems = [
  ['¿Como calculo cuanto material necesito?', 'Mide ancho y alto del muro, resta vanos y agrega un margen de merma antes de solicitar cotizacion.'],
  ['¿Puedo instalarlo en exterior?', product.macroCategory === 'exterior' ? 'Si, esta familia esta pensada para uso exterior segun la preparacion del sustrato.' : 'Esta variante esta orientada a interior; valida exposicion y humedad antes de instalar.'],
  ['¿Que incluye la ficha tecnica?', 'Medidas, presentacion, cuidados, garantia y recomendaciones de instalacion.']
];
---

<main>
  <!-- Seccion: Detalle de producto -->
  <section class="product-detail" data-reveal-group>
    <a class="back-link" href="/productos">Volver al catalogo</a>
    <div class="detail-layout">
      <div class="detail-media motion-card__media" data-product-gallery data-reveal="hero">
        {product.image ? <img class="motion-product-image" src={product.image} alt={product.name} /> : <span class="motion-product-image" aria-hidden="true"></span>}
      </div>
      <article class="detail-copy" data-reveal-group>
        <p data-reveal>{product.categoryName ?? category?.name ?? product.macroCategory}</p>
        <h1 data-reveal>{product.name}</h1>
        {product.sku && <strong data-reveal>SKU: {product.sku}</strong>}
        <div class="summary" data-reveal>{product.summary ?? 'Producto Deco en preparacion para publicacion final.'}</div>
         <div class="detail-block" data-reveal>
          <h2>Variantes de la familia</h2>
          <div class="tone-selector" aria-label="Variantes disponibles">
            {variantItems.map((variantProduct, index) => (
              <a class={variantProduct.slug === product.slug ? 'active' : ''} href={`/productos/${variantProduct.slug}`} aria-current={variantProduct.slug === product.slug ? 'page' : undefined} title={variantProduct.name}>
                <span class={`tone-dot${variantProduct.image ? ' tone-dot-image' : ` tone-dot-${(index % 8) + 1}`}`} aria-hidden="true">
                  {variantProduct.image && <img src={variantProduct.image} alt="" loading="lazy" />}
                </span>
                <small>{variantProduct.variants[0]?.colors[0]?.name ?? variantProduct.name}</small>
              </a>
            ))}
          </div>
        </div>
        <div class="detail-block" data-reveal>
          <h2>Datos comerciales</h2>
           <div class="chips">
             <small>{activeTone?.name ?? 'Acabado por confirmar'}</small>
             <small>{product.macroCategory}</small>
             <small>{product.variants[0]?.name ?? 'Presentacion por confirmar'}</small>
             {product.price != null && <small>Precio: ${product.price.toFixed(2)}</small>}
           </div>
         </div>
         {technicalRows.length > 0 && <div class="product-specs" data-reveal>
           <p>Especificaciones del producto</p>
           <dl>
             {technicalRows.map(([label, value]) => (
               <div class="product-spec-row">
                 <dt>{label}</dt>
                 <dd>{value}</dd>
               </div>
             ))}
           </dl>
         </div>}
         <a class="quote-link motion-button" data-reveal href="/contacto">Solicitar cotizacion</a>
      </article>
    </div>
  </section>

  <section class="quote-calculator" data-reveal="section" aria-labelledby="calculator-title">
    <div>
      <p>Calcula cuanto material necesitas antes de proyecto</p>
      <h2 id="calculator-title">Estimador rapido</h2>
    </div>
    <form class="calculator-form">
      <label>Area total m2<input class="motion-field" type="number" value="0" min="0" /></label>
      <label>Merma %<input class="motion-field" type="number" value="10" min="0" /></label>
      <label>Cajas estimadas<input class="motion-field" type="number" value="0" min="0" /></label>
      <a class="motion-button" href="/contacto">Cotizar aqui</a>
    </form>
  </section>

   {(visibility.technical || visibility.support) && <section class="technical-section" data-reveal="section" aria-labelledby="technical-title">
     {visibility.technical && <div class="technical-copy">
      <p>Informacion tecnica</p>
      <h2 id="technical-title">Especificacion, cuidados y soporte</h2>
       <details open>
         <summary>Descripcion</summary>
         <p>{product.description ?? product.summary ?? 'Revestimiento decorativo para proyectos residenciales y comerciales.'}</p>
      </details>
       <details>
         <summary>Dimensiones</summary>
         <p>{product.dimensions ?? 'Medidas por confirmar en ficha tecnica.'}{product.thickness ? ` · Espesor: ${product.thickness}` : ''}</p>
       </details>
       <details>
         <summary>Cuidados y garantia</summary>
         <p>{product.careNotes ?? 'Cuidados por confirmar.'}</p>
       </details>
     </div>}
     {visibility.support && <aside class="support-card">
      <h2>Material de apoyo</h2>
       {visibility.support && product.technicalSheetUrl && <a href={product.technicalSheetUrl} target="_blank" rel="noreferrer">Descargar ficha tecnica</a>}
       {visibility.support && product.installationGuideUrl && <a href={product.installationGuideUrl} target="_blank" rel="noreferrer">Guia de instalacion</a>}
      <div class="plan-preview" aria-label="Plano acotado de instalacion"></div>
     </aside>}
   </section>}

   {(visibility.faq || visibility.installation) && <section class="faq-installation" data-reveal-group>
     {visibility.faq && <div class="faq-list">
      <h2>Preguntas frecuentes</h2>
      {faqItems.map(([question, answer]) => (
        <details class="motion-accordion" data-reveal>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
     </div>}
     {visibility.installation && <div class="installation-list">
      <h2>Guia de instalacion</h2>
      {['Preparar superficie', 'Trazar modulacion', 'Cortar piezas', 'Aplicar fijacion', 'Instalar de abajo hacia arriba', 'Rematar bordes', 'Limpiar y revisar'].map((step, index) => (
        <p data-reveal><span>{String(index + 1).padStart(2, '0')}</span>{step}</p>
      ))}
     </div>}
   </section>}

  <!-- Seccion: Productos relacionados -->
  <section class="related-section" data-reveal-group>
    <h2 data-reveal>Relacionados</h2>
    <div class="related-grid">
      {relatedProducts.length > 0 ? relatedProducts.map((item) => (
        <a class="motion-card" data-reveal href={`/productos/${item.slug}`}>
          <span>{item.macroCategory}</span>
          <strong>{item.name}</strong>
        </a>
      )) : <p>No hay relacionados disponibles por ahora.</p>}
    </div>
  </section>
</main>

<style>
  .product-detail {
    padding: 64px 8vw 78px;
    background: var(--white-pure);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: #677067;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .back-link::before {
    content: '← ';
  }

  .detail-layout {
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(320px, 1fr);
    gap: 58px;
    align-items: center;
  }

  .detail-media {
    min-height: 560px;
    display: grid;
    place-items: center;
    background: #f0f0ec;
  }

  .detail-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .detail-media span {
    width: 52%;
    height: 64%;
    transform: perspective(640px) rotateX(56deg) rotateZ(-22deg);
    background: repeating-linear-gradient(90deg, #7a4f2c 0 22px, #c69055 22px 38px, #2b2018 38px 46px);
    box-shadow: 18px 28px 40px rgba(0, 0, 0, 0.22);
  }

  .detail-copy p {
    margin: 0 0 18px;
    color: var(--green-text);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .detail-copy h1 {
    margin: 0 0 20px;
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .detail-copy strong {
    display: block;
    margin-bottom: 22px;
    color: #677067;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
  }

  .summary {
    max-width: 560px;
    color: #596059;
    line-height: 1.7;
  }

  .detail-block {
    margin-top: 30px;
  }

  .detail-block h2,
  .related-section h2 {
    margin: 0 0 14px;
    color: #818781;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tone-selector {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .tone-selector a {
    display: grid;
    justify-items: center;
    gap: 8px;
    color: #777f77;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tone-selector a.active {
    color: var(--black);
  }

  .tone-dot {
    width: 38px;
    height: 38px;
    display: block;
    position: relative;
    border-radius: 999px;
    border: 2px solid var(--white-pure);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
    overflow: hidden;
  }

  .tone-dot-image {
    background: #f0f0ec;
  }

  .tone-dot-image img {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    display: block;
    object-fit: cover;
    object-position: center;
    transform: scale(5);
    transform-origin: center;
  }

  .tone-dot-1 { background: #8d5b32; }
  .tone-dot-2 { background: #c69055; }
  .tone-dot-3 { background: #b76f2f; }
  .tone-dot-4 { background: #6a442b; }
  .tone-dot-5 { background: #d8c6af; }
  .tone-dot-6 { background: #3d3833; }
  .tone-dot-7 { background: #a67b55; }
  .tone-dot-8 { background: #705f4f; }

  .chips small {
    padding: 8px 12px;
    border: 1px solid #d4d8d2;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-specs {
    margin-top: 34px;
  }

  .product-specs > p {
    margin: 0 0 12px;
    color: var(--green-text);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .product-specs dl {
    margin: 0;
    border-top: 1px solid var(--black);
  }

  .product-spec-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 20px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--paper-line);
  }

  .product-spec-row dt {
    color: #737a73;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-spec-row dd {
    margin: 0;
    color: var(--black);
    font-size: 0.82rem;
    font-weight: 700;
    text-align: right;
  }

  .quote-link {
    display: inline-block;
    margin-top: 38px;
    padding: 15px 22px;
    background: var(--blue);
    color: var(--white-pure);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .related-section {
    padding: 54px 8vw 82px;
    background: var(--white);
  }

  .quote-calculator,
  .technical-section,
  .faq-installation {
    padding: 54px 8vw;
    background: #ecedeb;
  }

  .quote-calculator {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(320px, 1.2fr);
    gap: 32px;
    align-items: end;
    border-top: 1px solid var(--paper-line);
  }

  .quote-calculator p,
  .technical-copy > p {
    margin: 0 0 10px;
    color: var(--green-text);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .quote-calculator h2,
  .technical-copy h2,
  .faq-list h2,
  .installation-list h2 {
    margin: 0 0 20px;
    font-size: clamp(1.8rem, 3.5vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .calculator-form {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .calculator-form label {
    color: #737a73;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .calculator-form input {
    width: 100%;
    margin-top: 8px;
    padding: 13px 12px;
    border: 1px solid #d2d5cf;
    background: var(--white-pure);
    color: var(--black);
  }

  .calculator-form a {
    display: grid;
    place-items: center;
    padding: 13px;
    background: var(--blue);
    color: var(--white-pure);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  .technical-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 40px;
    background: var(--white-pure);
  }

  details {
    border-top: 1px solid var(--paper-line);
  }

  details:last-child {
    border-bottom: 1px solid var(--paper-line);
  }

  summary {
    padding: 18px 0;
    cursor: pointer;
    font-weight: 800;
    text-transform: uppercase;
  }

  details p {
    margin: 0 0 18px;
    color: #596059;
    line-height: 1.7;
  }

  .support-card {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 24px;
    background: #f3f3ef;
  }

  .support-card h2 {
    margin: 0 0 8px;
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .support-card a {
    padding: 13px 0;
    border-bottom: 1px solid var(--paper-line);
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .plan-preview {
    min-height: 260px;
    margin-top: 16px;
    background:
      linear-gradient(90deg, transparent 0 49%, #9aa09a 49% 51%, transparent 51% 100%),
      repeating-linear-gradient(90deg, transparent 0 28px, rgba(0, 0, 0, 0.1) 28px 29px),
      repeating-linear-gradient(0deg, transparent 0 28px, rgba(0, 0, 0, 0.1) 28px 29px),
      #fff;
  }

  .faq-installation {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
    gap: 42px;
  }

  .installation-list p {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 18px;
    margin: 0;
    padding: 15px 0;
    border-bottom: 1px solid var(--paper-line);
    color: #596059;
    font-weight: 700;
  }

  .installation-list span {
    color: var(--blue);
    font-weight: 800;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .related-grid a {
    min-height: 150px;
    display: grid;
    align-content: end;
    gap: 10px;
    padding: 22px;
    background: var(--white-pure);
    border: 1px solid var(--paper-line);
  }

  .related-grid span {
    color: var(--green-text);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .related-grid strong {
    font-size: 1.2rem;
    text-transform: uppercase;
  }

  @media (max-width: 850px) {
    .detail-layout,
    .related-grid,
    .quote-calculator,
    .technical-section,
    .faq-installation,
    .calculator-form {
      grid-template-columns: 1fr;
    }

    .product-detail,
    .related-section,
    .quote-calculator,
    .technical-section,
    .faq-installation {
      padding-left: 20px;
      padding-right: 20px;
    }

    .detail-media {
      min-height: 380px;
    }
  }

  @media (max-width: 640px) {
    .product-detail {
      padding: 18px 14px 22px;
      background: #f4f4ef;
    }

    .back-link {
      margin-bottom: 14px;
      font-size: 0.56rem;
      letter-spacing: 0.12em;
    }

    .detail-layout {
      gap: 16px;
    }

    .detail-copy {
      display: contents;
    }

    .detail-copy p {
      order: -3;
      margin-bottom: 0;
      font-size: 0.56rem;
      letter-spacing: 0.14em;
    }

    .detail-copy h1 {
      order: -2;
      margin: 0;
      font-size: 1.55rem;
      letter-spacing: -0.03em;
      line-height: 1.05;
    }

    .detail-copy > strong {
      order: -1;
      margin-bottom: 0;
      font-size: 0.58rem;
    }

    .detail-media {
      min-height: 250px;
      border: 1px solid #e0e2dc;
      border-radius: 8px;
      background: var(--white-pure);
      overflow: hidden;
    }

    .detail-media span {
      width: 72%;
      height: 72%;
      transform: none;
      border-radius: 4px;
      box-shadow: none;
    }

    .summary {
      display: none;
    }

    .detail-block {
      margin-top: 0;
      padding: 14px 0;
      border-bottom: 1px solid #d8dbd5;
    }

    .detail-block h2,
    .related-section h2 {
      margin-bottom: 10px;
      font-size: 0.58rem;
      letter-spacing: 0.14em;
    }

    .tone-selector {
      flex-wrap: nowrap;
      gap: 9px;
      overflow-x: auto;
      padding-bottom: 2px;
    }

    .tone-selector a {
      min-width: 42px;
      font-size: 0;
    }

    .tone-dot {
      width: 34px;
      height: 34px;
    }

    .chips small {
      padding: 0;
      border: 0;
      font-size: 0.58rem;
    }

    .product-specs {
      margin-top: 22px;
    }

    .product-specs > p {
      font-size: 0.58rem;
      letter-spacing: 0.12em;
    }

    .product-spec-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 12px;
      padding: 12px 0;
    }

    .product-spec-row dt {
      font-size: 0.58rem;
    }

    .product-spec-row dd {
      font-size: 0.72rem;
    }

    .quote-link {
      width: 100%;
      margin-top: 6px;
      padding: 17px;
      border-radius: 5px;
      text-align: center;
      font-size: 0.62rem;
    }

    .quote-calculator,
    .technical-section,
    .faq-installation,
    .related-section {
      padding: 22px 14px;
    }

    .quote-calculator {
      gap: 16px;
      background: #f4f4ef;
    }

    .quote-calculator p,
    .technical-copy > p {
      font-size: 0.56rem;
      letter-spacing: 0.12em;
    }

    .quote-calculator h2,
    .technical-copy h2,
    .faq-list h2,
    .installation-list h2 {
      font-size: 1.65rem;
      line-height: 1.05;
    }

    .calculator-form {
      padding: 14px;
      border: 1px solid #d8dbd5;
      border-radius: 8px;
      background: var(--white-pure);
    }

    .calculator-form label {
      font-size: 0.58rem;
    }

    .calculator-form input {
      min-height: 44px;
      border-radius: 5px;
    }

    .calculator-form a {
      min-height: 48px;
      border-radius: 5px;
    }

    .technical-section {
      gap: 18px;
      background: #f4f4ef;
    }

    .technical-copy,
    .support-card,
    .faq-list,
    .installation-list {
      padding: 16px;
      border-radius: 8px;
      background: var(--white-pure);
    }

    summary {
      padding: 14px 0;
      font-size: 0.68rem;
    }

    details p {
      font-size: 0.78rem;
    }

    .support-card {
      padding: 16px;
    }

    .support-card h2 {
      font-size: 0.68rem;
    }

    .plan-preview {
      min-height: 180px;
    }

    .faq-installation {
      gap: 14px;
      background: #f4f4ef;
    }

    .installation-list p {
      grid-template-columns: 34px 1fr;
      gap: 10px;
      font-size: 0.78rem;
    }

    .installation-list span {
      width: 24px;
      height: 24px;
      display: inline-grid;
      place-items: center;
      border-radius: 999px;
      background: var(--blue);
      color: var(--white-pure);
      font-size: 0.62rem;
    }

    .related-section {
      background: #f4f4ef;
    }

    .related-grid {
      display: flex;
      gap: 10px;
      overflow-x: auto;
    }

    .related-grid a {
      min-width: 118px;
      min-height: 118px;
      padding: 14px;
      border-radius: 7px;
