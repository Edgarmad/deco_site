---
import type { ProductMacroCategory } from '../../types/products';

type Props = {
  productTypes: { slug: string; name: string; macroCategory: ProductMacroCategory }[];
};

const { productTypes } = Astro.props;
// Los filtros se renderizan desde los tipos reales de producto para que coincidan con cada card.
---

<aside class="product-filters motion-filterbar" data-filter-panel data-sticky-filter>
  <div class="filter-body motion-filter-panel" data-filter-body data-open="true">
    <fieldset>
      <legend>Tipo de producto</legend>
      {productTypes.map((productType) => (
        <label>
          <input type="checkbox" value={productType.slug} data-category-filter />
          <span>{productType.name}</span>
        </label>
      ))}
    </fieldset>
    <fieldset>
      <legend>Colores</legend>
      {['Brasilia', 'Gold Rio', 'Roble Dorado'].map((color) => (
        <label>
          <input type="checkbox" value={color.toLowerCase()} data-color-filter />
          <span>{color}</span>
        </label>
      ))}
    </fieldset>
    <label class="search-label" for="product-search">Buscar</label>
    <input id="product-search" class="motion-field" type="search" placeholder="Nombre, SKU o color" data-search-input />
  </div>
</aside>

<style>
  .product-filters {
    align-self: start;
    min-height: 100%;
    padding-right: 20px;
    border-right: 1px solid var(--paper-line);
  }

  .filter-body.hidden {
    display: none;
  }

  fieldset {
    display: grid;
    gap: 10px;
    margin: 0 0 24px;
    padding: 0;
    border: 0;
  }

  legend,
  .search-label {
    margin-bottom: 12px;
    color: var(--black);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--black);
    font-size: 0.72rem;
    line-height: 1.25;
  }

  input[type='checkbox'] {
    width: 14px;
    height: 14px;
    accent-color: var(--blue);
  }

  input[type='search'] {
    width: 100%;
    margin-top: 10px;
    padding: 12px 13px;
    border: 1px solid #d4d8d2;
    background: var(--white-pure);
    color: var(--black);
  }

  @media (max-width: 900px) {
    .product-filters {
      padding-right: 0;
      border-right: 0;
      border-bottom: 1px solid var(--paper-line);
      padding-bottom: 18px;
    }
  }

  @media (max-width: 640px) {
    .product-filters {
      display: grid;
      gap: 12px;
      min-height: 0;
      padding-bottom: 8px;
      border-bottom: 0;
    }

    .filter-body {
      display: grid;
      gap: 14px;
      padding: 12px;
      border: 1px solid #dedfd9;
      border-radius: 0;
      background: var(--white-pure);
    }

    fieldset {
      gap: 9px;
      margin-bottom: 0;
    }

    legend,
    .search-label {
      margin-bottom: 8px;
      font-size: 0.58rem;
      letter-spacing: 0.12em;
    }

    label {
      font-size: 0.72rem;
    }

    input[type='search'] {
      margin-top: 0;
      border-radius: 6px;
    }
  }
</style>
