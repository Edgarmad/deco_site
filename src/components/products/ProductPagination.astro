---
type Props = {
  total: number;
  perPage?: number;
};

const { total, perPage = 12 } = Astro.props;
---

<nav class="product-pagination" aria-label="Paginacion de productos" data-pagination data-per-page={perPage}>
  <p data-pagination-summary>Mostrando 1-{Math.min(total, perPage)} de {total} productos</p>
  <div class="pagination-buttons">
    <button type="button" data-page-prev disabled>Anterior</button>
    <span data-page-numbers></span>
    <span class="current-page-label" data-page-current>1</span>
    <button type="button" data-page-next disabled>Siguiente</button>
  </div>
</nav>

<style>
  .product-pagination {
    display: grid;
    justify-items: center;
    gap: 18px;
    padding: 28px 0 56px;
  }

  .product-pagination p {
    margin: 0;
    color: #747a74;
    font-size: 0.8rem;
  }

  .pagination-buttons {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .pagination-buttons button,
  .pagination-buttons span {
    min-width: 40px;
    height: 40px;
    display: inline-grid;
    place-items: center;
    border: 1px solid #d0d4ce;
    background: transparent;
    color: var(--black);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .pagination-buttons button[aria-current='page'] {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--white-pure);
  }

  .pagination-buttons .current-page-label {
    display: none;
  }

  .pagination-buttons button:not(:disabled):hover,
  .pagination-buttons button:not(:disabled):focus-visible {
    border-color: var(--green);
    color: var(--green-text);
  }

  .pagination-buttons button:not(:disabled) {
    cursor: pointer;
  }

  .pagination-buttons button:disabled {
    color: #aeb3ae;
  }

  .pagination-buttons button[aria-current='page']:disabled {
    color: var(--white-pure);
  }

  @media (max-width: 640px) {
    .product-pagination {
      gap: 8px;
      padding: 2px 0 14px;
    }

    .product-pagination p {
      font-size: 0.58rem;
    }

    .pagination-buttons {
      width: 100%;
      justify-content: center;
      gap: 6px;
    }

    .pagination-buttons button,
    .pagination-buttons span {
      min-width: 30px;
      height: 24px;
      font-size: 0.56rem;
    }
  }
</style>
