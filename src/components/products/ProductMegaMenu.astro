---
import type { ProductCategory, ProductMacroCategory } from '../../types/products';

type Props = {
  categories: ProductCategory[];
  activeCategory?: string;
};

const { activeCategory = '' } = Astro.props;
const productTypes: { slug: string; name: string; macroCategory: ProductMacroCategory; href: string }[] = [
  { slug: 'lambrin', name: 'Lambrin', macroCategory: 'interior', href: '/productos?categoria=interior&familia=lambrin' },
  { slug: 'panel-reforzado-spc', name: 'Panel reforzado', macroCategory: 'interior', href: '/productos?categoria=interior&familia=panel-reforzado-spc' },
  { slug: 'placas-marmol-pvc', name: 'Placa marmol', macroCategory: 'interior', href: '/productos?categoria=interior&familia=placas-marmol-pvc' },
  { slug: 'plafon-pvc', name: 'Panel PVC', macroCategory: 'interior', href: '/productos?categoria=interior&familia=plafon-pvc' },
  { slug: 'piso-spc', name: 'Piso SPC', macroCategory: 'interior', href: '/productos?categoria=interior&familia=piso-spc' },
  { slug: 'cristal-carbono', name: 'Cristal carbono', macroCategory: 'interior', href: '/productos?categoria=interior&familia=cristal-carbono' },
  { slug: 'piedra-pu', name: 'Piedra PU', macroCategory: 'interior', href: '/productos?categoria=interior&familia=piedra-pu' },
  { slug: 'lambrin-asa', name: 'Lambrin exterior', macroCategory: 'exterior', href: '/productos?categoria=exterior&familia=lambrin-asa' },
  { slug: 'wall-cladding-asa', name: 'Wall cladding', macroCategory: 'exterior', href: '/productos?categoria=exterior&familia=wall-cladding-asa' },
  { slug: 'deck-coextruido', name: 'Deck exterior', macroCategory: 'exterior', href: '/productos?categoria=exterior&familia=deck-coextruido' },
  { slug: 'accesorios', name: 'Accesorios', macroCategory: 'exterior', href: '/productos?categoria=exterior&familia=accesorios' }
];
const groups: { label: string; macroCategory: ProductMacroCategory }[] = [
  { label: 'Productos de interior', macroCategory: 'interior' },
  { label: 'Productos de exterior', macroCategory: 'exterior' }
];
---

<div class="product-mega-menu" data-product-mega-menu>
  {groups.map((group) => {
    const groupProductTypes = productTypes.filter((productType) => productType.macroCategory === group.macroCategory);
    return (
      <section class="mega-group">
        <a class="mega-trigger" href={`/productos?categoria=${group.macroCategory}`}>
          {group.label}
        </a>
        <nav class="mega-panel" aria-label={group.label}>
            {groupProductTypes.map((productType) => (
              <a class={activeCategory === productType.slug ? 'active' : ''} href={productType.href} aria-current={activeCategory === productType.slug ? 'page' : undefined}>
                {productType.name}
              </a>
            ))}
        </nav>
      </section>
    );
  })}
</div>

<style>
  .product-mega-menu {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--black-deep);
    color: var(--white);
    text-transform: uppercase;
  }

  .mega-group {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mega-group + .mega-group {
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mega-trigger {
    display: grid;
    place-items: center;
    min-height: 42px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    cursor: pointer;
  }

  .mega-trigger:focus-visible {
    outline: 1px solid var(--blue);
    outline-offset: -5px;
  }

  .mega-panel {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    padding: 8px 8vw 28px;
    background: var(--black-deep);
  }

  .mega-panel a {
    padding: 10px 16px;
    border-radius: 999px;
    color: #d8ded8;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .mega-panel a:hover,
  .mega-panel a:focus-visible,
  .mega-panel a.active {
    background: var(--blue);
    color: var(--white-pure);
  }

  @media (max-width: 760px) {
    .product-mega-menu {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      display: grid;
    }

    .mega-trigger {
      min-height: 26px;
      font-size: 0.54rem;
      letter-spacing: 0.24em;
    }

    .mega-group + .mega-group {
      border-left: 1px solid rgba(255, 255, 255, 0.08);
    }

    .mega-panel {
      justify-content: flex-start;
      padding: 0 20px 22px;
    }
  }
</style>
