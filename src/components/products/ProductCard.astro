---
import type { Product } from '../../types/products';

type Props = {
  product: Product;
  index: number;
  level?: 'family' | 'variant';
};

const { product, index, level = 'variant' } = Astro.props;
const primaryColor = product.variants.flatMap((variant) => variant.colors)[0];
const productVariant = product.variants[0];
const productVariantKey = productVariant ? `${product.categorySlug}:${productVariant.slug}` : '';
const cardImage = product.secondaryImage ?? product.image;
// data-* concentra la informacion que usan filtros, busqueda y ordenamiento sin re-renderizar Astro.
const searchText = [
  product.name,
  product.categoryName,
  product.sku,
  product.macroCategory,
  product.categorySlug,
  ...product.variants.map((variant) => variant.name),
  ...product.variants.flatMap((variant) => variant.colors.map((color) => color.name))
].filter(Boolean).join(' ').toLowerCase();
---

<article
  class="catalog-card motion-card"
  data-reveal
  data-product-card
  data-level={level}
  data-macro={product.macroCategory}
  data-category={product.categorySlug}
  data-variant={productVariantKey || undefined}
  data-search={searchText}
  data-name={product.name.toLowerCase()}
  data-featured={product.featured ? 'true' : 'false'}
  data-order={productVariant?.sortOrder ?? 0}
  data-index={index}
>
  <a href={level === 'family' ? `/productos?categoria=${product.macroCategory}&subcategoria=${productVariantKey}` : `/productos/${product.slug}`} aria-label={level === 'family' ? `Ver acabados de ${product.name}` : `Ver ${product.name}`}>
    <div class={`catalog-visual catalog-visual-${(index % 6) + 1} motion-card__media`}>
      {cardImage ? <img src={cardImage} alt={product.name} loading="lazy" /> : <span aria-hidden="true"></span>}
    </div>
    <div class="catalog-copy">
      <h2>{product.name}</h2>
      {product.sku && <p>SKU: {product.sku}</p>}
      <small>{primaryColor ? `${productVariant?.name ?? 'Variante'} · ${productVariant.colors.length} colores` : productVariant?.name ?? 'Variante por confirmar'}</small>
      <em class="motion-card__arrow">Ver ficha y variantes</em>
    </div>
  </a>
</article>

<style>
  .catalog-card {
    text-align: center;
  }

  .catalog-card[hidden] {
    display: none;
  }

  .catalog-card a {
    display: grid;
    height: 100%;
    grid-template-rows: auto 1fr;
    gap: 10px;
    padding: 0 4px 14px;
  }

  .catalog-visual {
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: transparent;
  }

  .catalog-visual img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
  }

  .catalog-visual span {
    width: 54%;
    height: 70%;
    display: block;
    transform: perspective(520px) rotateX(56deg) rotateZ(-22deg);
    box-shadow: 12px 18px 28px rgba(0, 0, 0, 0.2);
  }

  .catalog-visual-1 span { background: repeating-linear-gradient(90deg, #8d5b32 0 18px, #d1a070 18px 28px, #55341f 28px 34px); }
  .catalog-visual-2 span { background: repeating-linear-gradient(180deg, #b86d29 0 22px, #222 22px 29px, #ddba8b 29px 51px); }
  .catalog-visual-3 span { background: repeating-linear-gradient(120deg, #c99b70 0 20px, #72513a 20px 35px, #e0c0a0 35px 49px); }
  .catalog-visual-4 span { background: repeating-linear-gradient(90deg, #252525 0 10px, #d7d7d1 10px 24px, #9c6b48 24px 34px); }
  .catalog-visual-5 span { background: linear-gradient(135deg, #59321e, #c6874e 52%, #21140d); }
  .catalog-visual-6 span { background: repeating-linear-gradient(90deg, #6e4a25 0 18px, #b97936 18px 32px, #2a1f17 32px 40px); }

  .catalog-copy h2 {
    min-height: 34px;
    margin: 0;
    color: var(--black);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .catalog-copy p,
  .catalog-copy small,
  .catalog-copy em {
    display: block;
    margin: 7px 0 0;
    color: #8b908b;
    font-size: 0.54rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .catalog-copy em {
    display: none;
  }

  @media (max-width: 640px) {
    .catalog-card {
      border: 0;
      border-radius: 0;
      background: transparent;
      overflow: hidden;
      text-align: center;
    }

    .catalog-card a {
      grid-template-rows: auto 1fr;
      gap: 6px;
      padding: 0 0 10px;
    }

    .catalog-visual {
      border-radius: 0;
      background: transparent;
    }

    .catalog-visual span {
      width: 68%;
      height: 78%;
      transform: none;
      border-radius: 2px;
      box-shadow: none;
    }

    .catalog-copy h2 {
      min-height: auto;
      font-size: 0.56rem;
      line-height: 1.15;
    }

    .catalog-copy p,
    .catalog-copy small,
    .catalog-copy em {
      margin-top: 3px;
      font-size: 0.46rem;
      letter-spacing: 0.04em;
    }
  }
</style>
