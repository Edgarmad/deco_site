---
import { sectionLabels } from '../../lib/adminContent';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminSession } from '../../lib/adminAuth';
import { getCsrfToken, validateCsrfToken } from '../../lib/adminSecurity';
import { createSupabaseServerClient } from '../../lib/supabaseServer';
import { fallbackHomeHeroVideoUrl, fallbackWhatsappNumber } from '../../services/siteSettingsService';

export const prerender = false;

const session = await getAdminSession(Astro.request, Astro.cookies);
if (!session) return Astro.redirect('/admin/login');

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const csrfToken = getCsrfToken(Astro.cookies);
let whatsappNumber = fallbackWhatsappNumber;
let homeHeroVideoUrl = fallbackHomeHeroVideoUrl;
const sectionKeys = {
  technical: 'product_section_technical_enabled',
  support: 'product_section_support_enabled',
  faq: 'product_section_faq_enabled',
  installation: 'product_section_installation_enabled'
} as const;
let sectionVisibility = { technical: true, support: true, faq: true, installation: true };
let message = Astro.url.searchParams.get('saved') === '1' ? 'Configuración guardada.' : '';
let errorMessage = '';

const json = (data: object, status = 200) => new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  if (!validateCsrfToken(Astro.cookies, formData)) {
    if (['prepare-video', 'finish-video'].includes(String(formData.get('intent')))) return json({ error: 'La sesión expiró. Recarga la página.' }, 403);
    errorMessage = 'La sesión del formulario expiró. Recarga la página e intenta de nuevo.';
  } else if (formData.get('intent') === 'prepare-video') {
    const size = Number(formData.get('size_bytes'));
    const filename = String(formData.get('filename') ?? '');
    if (!Number.isSafeInteger(size) || size <= 0 || size > 50 * 1024 * 1024 || !filename.toLowerCase().endsWith('.mp4')) {
      return new Response(JSON.stringify({ error: 'Selecciona un MP4 de hasta 50 MB.' }), { status: 400, headers: { 'Content-Type': 'application/json' } });
    }
    const path = `settings/home-hero/${crypto.randomUUID()}.mp4`;
    const signed = await supabase.storage.from('site-media').createSignedUploadUrl(path, { upsert: false });
    if (signed.error) return new Response(JSON.stringify({ error: signed.error.message }), { status: 500, headers: { 'Content-Type': 'application/json' } });
    return json({ signedUrl: signed.data.signedUrl, path });
  } else if (formData.get('intent') === 'finish-video') {
    try {
      const path = String(formData.get('path') ?? '');
      const size = Number(formData.get('size_bytes'));
      if (!/^settings\/home-hero\/[0-9a-f-]{36}\.mp4$/.test(path) || !Number.isSafeInteger(size) || size <= 0 || size > 50 * 1024 * 1024) throw new Error('La subida no es válida.');
      const filename = path.split('/').pop()!;
      const files = await supabase.storage.from('site-media').list('settings/home-hero', { search: filename });
      if (files.error) throw new Error(files.error.message);
      const file = files.data.find(item => item.name === filename);
      if (!file || Number(file.metadata?.size) !== size || file.metadata?.mimetype !== 'video/mp4') throw new Error('No se pudo confirmar el video completo en Supabase. El video actual se conserva.');
      const publicUrl = supabase.storage.from('site-media').getPublicUrl(path).data.publicUrl;
      const saved = await supabase.from('site_settings').upsert({ key: 'home_hero_video_url', value: publicUrl, is_public: true }, { onConflict: 'key' }).select('value').single();
      if (saved.error) throw new Error(saved.error.message);
      return json({ publicUrl: saved.data.value });
    } catch (error) {
      return json({ error: error instanceof Error ? error.message : 'No se pudo guardar el video.' }, 400);
    }
  } else {
    const submittedNumber = String(formData.get('whatsapp_number') ?? '').replace(/\D/g, '');
    whatsappNumber = submittedNumber;
    for (const section of Object.keys(sectionVisibility) as (keyof typeof sectionVisibility)[]) sectionVisibility[section] = formData.get(`section_${section}`) === 'on';
    if (submittedNumber.length < 8 || submittedNumber.length > 15) {
      errorMessage = 'Ingresa un número válido de 8 a 15 dígitos.';
      whatsappNumber = submittedNumber;
    }
    if (!errorMessage) {
      const settings = [
        { key: 'whatsapp_number', value: submittedNumber, is_public: true },
        ...Object.entries(sectionKeys).map(([section, key]) => ({
          key,
          value: formData.get(`section_${section}`) === 'on' ? 'true' : 'false',
          is_public: true
        }))
      ];
      const { error } = await supabase.from('site_settings').upsert(settings, { onConflict: 'key' });
      if (error) errorMessage = error.message;
      else return Astro.redirect('/admin/configuracion?saved=1');
    }
  }
}

if (!whatsappNumber || !errorMessage) {
  const { data } = await supabase
    .from('site_settings')
    .select('key,value')
    .in('key', ['whatsapp_number', 'home_hero_video_url']);
  const settings = new Map((data ?? []).map(setting => [setting.key, setting.value]));
  whatsappNumber = settings.get('whatsapp_number')?.replace(/\D/g, '') || whatsappNumber;
  homeHeroVideoUrl = settings.get('home_hero_video_url') || homeHeroVideoUrl;
}

const { data: sectionSettings } = await supabase
  .from('site_settings')
  .select('key,value')
  .in('key', Object.values(sectionKeys));
for (const setting of Astro.request.method === 'POST' ? [] : sectionSettings ?? []) {
  const section = (Object.entries(sectionKeys).find(([, key]) => key === setting.key)?.[0] ?? '') as keyof typeof sectionVisibility;
  if (section) sectionVisibility[section] = setting.value === 'true';
}
---

<AdminLayout title="Configuración" currentPath="/admin/configuracion" userEmail={session.user.email}>
  <header class="admin-page-head compact">
    <div>
      <p class="admin-kicker">Configuración del sitio</p>
      <h1>Contacto</h1>
      <p class="admin-note">Actualiza el número que usa el botón flotante de WhatsApp.</p>
    </div>
  </header>

  {message && <p class="admin-success">{message}</p>}
  {errorMessage && <p class="admin-error">No se pudo guardar: {errorMessage}</p>}

  <section class="admin-panel pad">
    <form class="admin-form" method="post">
      <input type="hidden" name="csrf_token" value={csrfToken} />
      <div class="admin-field">
        <label for="whatsapp_number">Número de WhatsApp</label>
        <input id="whatsapp_number" name="whatsapp_number" type="tel" value={whatsappNumber} placeholder="9931595909" required />
        <small class="admin-note">Usa el número con código de país si no es de México. Para números mexicanos de 10 dígitos se agrega +52 automáticamente.</small>
      </div>
      <fieldset class="admin-field">
        <legend>Secciones de productos visibles globalmente</legend>
        {(['technical', 'support', 'faq', 'installation'] as const).map((section) => (
          <label><input name={`section_${section}`} type="checkbox" checked={sectionVisibility[section]} /> {sectionLabels[section]}</label>
        ))}
        <small class="admin-note">Estas opciones aplican a todos los productos. Cada producto puede tener una configuración individual.</small>
      </fieldset>
      <button class="admin-button" type="submit">Guardar configuración</button>
    </form>
  </section>
  <section class="admin-panel pad" data-video-settings>
    <h2>Video del inicio</h2>
    <p class="admin-note">Sube un nuevo video. Se reemplazará el video del hero únicamente después de confirmar la subida y guardar el cambio.</p>
    <input type="hidden" name="csrf_token" value={csrfToken} />
    <div class="admin-field">
      <label for="home_hero_video_file">Seleccionar nuevo video</label>
      <input id="home_hero_video_file" type="file" accept="video/mp4,.mp4" />
      <small class="admin-note">MP4 de hasta 50 MB. Resolución recomendada: 1920 × 1080 px.</small>
    </div>
    <button class="admin-button" type="button" data-video-upload disabled>Subir y actualizar video</button>
    <progress data-video-progress max="100" hidden aria-label="Progreso de subida del video"></progress>
    <p data-video-status role="status" aria-live="polite">Selecciona un archivo para subirlo.</p>
    <p>Video actual: <a data-current-video href={homeHeroVideoUrl} target="_blank" rel="noopener">Abrir video guardado</a></p>
    <a href="/" target="_blank" rel="noopener">Ver video en el homepage</a>
    <noscript>Activa JavaScript para subir el video.</noscript>
  </section>
  <script src="../../scripts/adminVideoSettings.ts"></script>
</AdminLayout>
