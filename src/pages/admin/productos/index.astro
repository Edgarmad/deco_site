---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminSession } from '../../../lib/adminAuth';
import { getPublicStorageUrl } from '../../../lib/supabase';
import { createSupabaseServerClient } from '../../../lib/supabaseServer';
import { isUuid } from '../../../lib/adminContent';

export const prerender = false;

type ProductOptionAdminRow = {
  id: string;
  name: string;
  slug: string;
  sku: string | null;
  status: 'draft' | 'published';
  updated_at: string;
  fallback_image_path: string | null;
  variant_id: string;
  product_images: {
    storage_bucket: string;
    storage_path: string;
    alt_text: string | null;
    kind: string;
    sort_order: number;
  }[];
  product_variants: {
    name: string;
    products: {
      name: string;
      categories: {
        name: string;
      } | null;
    } | null;
  } | null;
};

const session = await getAdminSession(Astro.request, Astro.cookies);
if (!session) return Astro.redirect('/admin/login');

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const search = Astro.url.searchParams.get('q')?.trim() ?? '';
const status = Astro.url.searchParams.get('status') ?? 'all';
const familyId = isUuid(Astro.url.searchParams.get('familia') ?? '') ? Astro.url.searchParams.get('familia')! : '';
const familyView = !familyId && Astro.url.searchParams.get('vista') !== 'acabados';
const rawPage = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isSafeInteger(rawPage) && rawPage > 0 ? Math.min(rawPage, 100000) : 1;
const pageSize = 8;
const from = (page - 1) * pageSize;
const to = from + pageSize - 1;

let query = supabase
  .from('product_options')
  .select('id,name,slug,sku,status,updated_at,variant_id,fallback_image_path,product_images(storage_bucket,storage_path,alt_text,kind,sort_order),product_variants(name,products(name,categories(name)))', { count: 'exact' })
  .order('updated_at', { ascending: false })
  .range(from, to);

if (search) {
  const term = search.replace(/[^\p{L}\p{N}\s-]/gu, '').slice(0, 150);
  if (term) query = query.or(`name.ilike.%${term}%,slug.ilike.%${term}%,sku.ilike.%${term}%`);
}

if (status === 'draft' || status === 'published') {
  query = query.eq('status', status);
}
if (familyId) query = query.eq('variant_id', familyId);
type FamilyRow = { id: string; name: string; status: string; products: { name: string; status: string; categories: { name: string; status: string } }; product_options: { id: string; status: string }[] };
let familyRows: FamilyRow[] = [];
let familyCount = 0;
let familyError = '';
if (familyView) {
  let families = supabase.from('product_variants').select('id,name,status,products(name,status,categories(name,status)),product_options(id,status)', { count: 'exact' }).order('sort_order').order('id').range(from, to);
  if (search) families = families.ilike('name', `%${search.replace(/[%_]/g, '\\$&')}%`);
  if (['draft', 'published'].includes(status)) families = families.eq('status', status);
  const result = await families;
  familyRows = (result.data ?? []) as unknown as FamilyRow[]; familyCount = result.count ?? 0; familyError = result.error?.message ?? '';
}

const { data, error, count } = await query;
const cleanup = await supabase.from('media_cleanup_queue').select('id', { count: 'exact', head: true });
const products = (data ?? []) as unknown as ProductOptionAdminRow[];
const total = familyView ? familyCount : count ?? 0;
const totalPages = Math.max(Math.ceil(total / pageSize), 1);
const previousUrl = `/admin/productos?${new URLSearchParams({ q: search, status, vista: familyView ? 'familias' : 'acabados', familia: familyId, page: String(Math.max(page - 1, 1)) })}`;
const nextUrl = `/admin/productos?${new URLSearchParams({ q: search, status, vista: familyView ? 'familias' : 'acabados', familia: familyId, page: String(Math.min(page + 1, totalPages)) })}`;
---

<AdminLayout title="Productos" currentPath="/admin/productos" userEmail={session.user.email}>
  <header class="admin-page-head compact">
    <div>
      <p class="admin-kicker">Catalogo CMS</p>
      <h1>{familyView ? 'Familias del catálogo' : 'Acabados / colores'}</h1>
      <p class="admin-note">{total} {familyView ? 'familias' : 'acabados'} · Inventario canónico: producto → familia/subcategoría → color.</p>
    </div>
    <a class="admin-link-button" href={familyView ? '/admin/variantes/nuevo' : `/admin/productos/nuevo${familyId ? `?familia=${familyId}` : ''}`}>{familyView ? 'Crear familia' : 'Crear acabado'}</a>
  </header>
  <p class="admin-note">Jerarquía: <a href="/admin/categorias">Categorías de uso</a> → <a href="/admin/familias">Tipos de producto</a> → <a href="/admin/variantes">Familias / subcategorías</a> → Acabados. En el Excel: Producto → Familia(Subcategoria) → Variante / Color. El sitio muestra una tarjeta por Familia(Subcategoria) y una URL por acabado.</p>
  <nav class="admin-actions" aria-label="Vista del catálogo"><a href="/admin/productos?vista=familias" aria-current={familyView ? 'page' : undefined}>Por familia</a><a href="/admin/productos?vista=acabados" aria-current={!familyView ? 'page' : undefined}>Todos los acabados</a></nav>
  {Astro.url.searchParams.has('saved') && <p class="admin-success" role="status">Cambios guardados.</p>}
  {(cleanup.count ?? 0) > 0 && <p class="admin-note">Hay archivos pendientes de limpiar. <a href="/admin/proyectos">Reintentar limpieza de Storage →</a></p>}

  <form class="admin-filters admin-panel" method="get">
    <input type="hidden" name="vista" value={familyView ? 'familias' : 'acabados'} /><input type="hidden" name="familia" value={familyId} />
    <input name="q" value={search} aria-label="Buscar" placeholder={familyView ? 'Buscar familia / subcategoría' : 'Buscar acabado, slug o SKU'} />
    <button class="admin-button secondary" type="submit">Buscar</button>
    <select name="status" aria-label="Estado">
      <option value="all" selected={status === 'all'}>Todos los estados</option>
      <option value="published" selected={status === 'published'}>Publicado</option>
      <option value="draft" selected={status === 'draft'}>Borrador</option>
    </select>
  </form>

  {error && <p class="admin-error">No se pudo cargar el catalogo: {error.message}</p>}
  {familyError && <p class="admin-error">{familyError}</p>}

  <section class="admin-panel admin-products-panel">
    {familyView ? <div class="admin-grid pad">{familyRows.map(family => {
      const visible = family.status === 'published' && family.products?.status === 'published' && family.products?.categories?.status === 'published';
      return <article class="admin-card"><h2>{family.name}</h2><p>{family.products?.categories?.name} / {family.products?.name}</p><p>{family.product_options.length} acabados · {family.product_options.filter(option => option.status === 'published').length} publicados</p><p>{visible ? 'Familia publicada' : 'Familia o padre en borrador: oculta en el sitio'}</p><a href={`/admin/productos?vista=acabados&familia=${family.id}`}>Ver acabados →</a><br /><a href={`/admin/variantes/${family.id}`}>Editar familia y PDF compartidos →</a></article>;
    })}{!familyRows.length && <p>No hay familias para mostrar.</p>}</div> : <>
    <table class="admin-table admin-products-table">
      <thead>
        <tr>
          <th>Producto</th>
          <th>Familia</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        {products.map((product) => {
          const image = product.product_images?.slice().sort((first, second) => first.sort_order - second.sort_order).find((item) => item.kind === 'main') ?? product.product_images?.[0];
          const title = `${product.product_variants?.products?.name ?? ''} ${product.name}`.trim();
          return (
            <tr>
              <td>
                <div class="admin-product-cell">
                  <img src={image ? getPublicStorageUrl(image.storage_bucket, image.storage_path) : getPublicStorageUrl('site-media', product.fallback_image_path)} alt={image?.alt_text ?? title} />
                  <div>
                    <a href={`/admin/productos/${product.id}`}>{title}</a>
                    <br />
                    <span class="admin-note">/{product.slug}</span>
                    {!image && <p class="admin-note">Imagen temporal: falta fotografía real</p>}
                  </div>
                </div>
              </td>
              <td>{product.product_variants?.products?.categories?.name ?? 'Sin categoria'} · <a href={`/admin/variantes/${product.variant_id}`}>{product.product_variants?.name}</a></td>
              <td><span class:list={['admin-status', product.status]}>{product.status === 'published' ? 'Publicado' : 'Borrador'}</span></td>
              <td><a href={`/admin/productos/${product.id}`}>Editar -></a></td>
            </tr>
          );
        })}
        {!products.length && (
          <tr>
            <td colspan="4">No hay productos para mostrar.</td>
          </tr>
        )}
      </tbody>
    </table>

    <div class="admin-products-list">
      <h2>{total} productos</h2>
      {products.map((product) => {
        const image = product.product_images?.slice().sort((first, second) => first.sort_order - second.sort_order).find((item) => item.kind === 'main') ?? product.product_images?.[0];
        const title = `${product.product_variants?.products?.name ?? ''} ${product.name}`.trim();
        return (
          <article class="admin-product-card">
            <img src={image ? getPublicStorageUrl(image.storage_bucket, image.storage_path) : getPublicStorageUrl('site-media', product.fallback_image_path)} alt={image?.alt_text ?? title} />
            <div>
              <h3>{title}</h3>
              <span class:list={['admin-status', product.status]}>{product.status === 'published' ? 'Publicado' : 'Borrador'}</span>
              <p>{product.product_variants?.products?.categories?.name ?? 'Sin categoria'} · {product.product_variants?.name}</p>
              <a href={`/admin/productos/${product.id}`}>Editar producto -></a>
            </div>
          </article>
        );
      })}
    </div>
    </>}

    <footer class="admin-pagination">
      <p class="admin-note">Mostrando {(familyView ? familyRows : products).length ? from + 1 : 0}-{Math.min(to + 1, total)} de {total} {familyView ? 'familias' : 'acabados'}</p>
      <div>
        <a class:list={['admin-link-button', 'secondary', page <= 1 && 'disabled']} href={previousUrl}>Anterior</a>
        <a class:list={['admin-link-button', 'secondary', page >= totalPages && 'disabled']} href={nextUrl}>Siguiente</a>
      </div>
    </footer>
  </section>
</AdminLayout>
