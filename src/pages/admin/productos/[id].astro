---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminSession } from '../../../lib/adminAuth';
import { getCsrfToken, validateCsrfToken } from '../../../lib/adminSecurity';
import { createSupabaseServerClient } from '../../../lib/supabaseServer';
import { getPublicStorageUrl } from '../../../lib/supabase';

export const prerender = false;

type ProductImageAdminRow = {
  id: string;
  storage_bucket: string;
  storage_path: string;
  alt_text: string | null;
  kind: 'main' | 'secondary' | 'gallery' | 'extra' | 'technical';
  sort_order: number;
};

type ProductOptionAdminDetail = {
  id: string;
  variant_id: string;
  name: string;
  slug: string;
  sku: string | null;
  price: number;
  summary: string | null;
  description: string | null;
  color_name: string | null;
  color_slug: string | null;
  color_hex: string | null;
  finish: string | null;
  dimensions: string | null;
  thickness: string | null;
  material: string | null;
  usage: string | null;
  installation_notes: string | null;
  care_notes: string | null;
  technical_specs: Record<string, unknown> | null;
  technical_sheet_url: string | null;
  installation_guide_url: string | null;
  section_visibility: Record<string, boolean> | null;
  status: 'draft' | 'published';
  featured: boolean;
  sort_order: number;
  seo_title: string | null;
  seo_description: string | null;
  canonical_path: string | null;
  product_images: ProductImageAdminRow[];
  product_variants: {
    name: string;
    products: {
      name: string;
      slug: string;
      categories: { name: string } | null;
    } | null;
  } | null;
};

const textValue = (formData: FormData, key: string) => {
  const value = String(formData.get(key) ?? '').trim();
  return value || null;
};

const numberValue = (formData: FormData, key: string) => {
  const rawValue = String(formData.get(key) ?? '').trim();
  return rawValue ? Number(rawValue) : 0;
};

const jsonValue = (formData: FormData, key: string) => {
  try {
    const value = JSON.parse(String(formData.get(key) ?? '{}'));
    return value && typeof value === 'object' && !Array.isArray(value) ? value : {};
  } catch {
    return {};
  }
};

const session = await getAdminSession(Astro.request, Astro.cookies);
if (!session) return Astro.redirect('/admin/login');

const id = Astro.params.id;
if (!id) return new Response(null, { status: 404 });

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const csrfToken = getCsrfToken(Astro.cookies);
let message = Astro.url.searchParams.get('saved') === '1' ? 'Cambios guardados.' : '';
let errorMessage = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const intent = String(formData.get('intent') ?? 'save-product');

  if (!validateCsrfToken(Astro.cookies, formData)) {
    errorMessage = 'La sesion del formulario expiro. Recarga la pagina e intenta de nuevo.';
  }

  if (!errorMessage && intent === 'delete-image') {
    const imageId = String(formData.get('image_id') ?? '');
    const { error } = await supabase.from('product_images').delete().eq('id', imageId).eq('option_id', id);
    if (error) errorMessage = error.message;
    else return Astro.redirect(`/admin/productos/${id}?saved=1`);
  }

  if (!errorMessage && intent === 'save-images') {
    const imageIds = formData.getAll('image_id').map(String);
    for (const imageId of imageIds) {
      const { error } = await supabase
        .from('product_images')
        .update({
          alt_text: textValue(formData, `alt_text_${imageId}`),
          kind: String(formData.get(`kind_${imageId}`) ?? 'gallery'),
          sort_order: numberValue(formData, `sort_order_${imageId}`)
        })
        .eq('id', imageId)
        .eq('option_id', id);

      if (error) {
        errorMessage = error.message;
        break;
      }
    }

    if (!errorMessage) return Astro.redirect(`/admin/productos/${id}?saved=1`);
  }

  if (!errorMessage && intent === 'save-product') {
    const { error } = await supabase
      .from('product_options')
      .update({
        name: textValue(formData, 'name'),
        slug: textValue(formData, 'slug'),
        sku: textValue(formData, 'sku'),
        price: Number(formData.get('price') ?? 1),
        summary: textValue(formData, 'summary'),
        description: textValue(formData, 'description'),
        color_name: textValue(formData, 'color_name'),
        color_slug: textValue(formData, 'color_slug'),
        color_hex: textValue(formData, 'color_hex'),
        finish: textValue(formData, 'finish'),
        dimensions: textValue(formData, 'dimensions'),
        thickness: textValue(formData, 'thickness'),
        material: textValue(formData, 'material'),
        usage: textValue(formData, 'usage'),
        installation_notes: textValue(formData, 'installation_notes'),
        care_notes: textValue(formData, 'care_notes'),
        technical_specs: jsonValue(formData, 'technical_specs'),
        technical_sheet_url: textValue(formData, 'technical_sheet_url'),
        installation_guide_url: textValue(formData, 'installation_guide_url'),
        section_visibility: {
          technical: formData.get('show_technical') === 'on',
          support: formData.get('show_support') === 'on',
          faq: formData.get('show_faq') === 'on',
          installation: formData.get('show_installation') === 'on'
        },
        status: String(formData.get('status') ?? 'draft'),
        featured: formData.get('featured') === 'on',
        sort_order: numberValue(formData, 'sort_order'),
        seo_title: textValue(formData, 'seo_title'),
        seo_description: textValue(formData, 'seo_description'),
        canonical_path: textValue(formData, 'canonical_path')
      })
      .eq('id', id);

    if (error) errorMessage = error.message;
    else return Astro.redirect(`/admin/productos/${id}?saved=1`);
  }
}

const { data, error } = await supabase
  .from('product_options')
  .select(`
    id,variant_id,name,slug,sku,price,summary,description,color_name,color_slug,color_hex,finish,dimensions,thickness,material,usage,installation_notes,care_notes,technical_specs,technical_sheet_url,installation_guide_url,section_visibility,status,featured,sort_order,seo_title,seo_description,canonical_path,
    product_images(id,storage_bucket,storage_path,alt_text,kind,sort_order),
    product_variants(name,products(name,slug,categories(name)))
  `)
  .eq('id', id)
  .maybeSingle();

if (error || !data) return new Response(null, { status: 404 });

const product = data as unknown as ProductOptionAdminDetail;
const images = (product.product_images ?? []).slice().sort((first, second) => first.sort_order - second.sort_order);
---

<AdminLayout title={`Editar ${product.name}`} currentPath="/admin/productos" userEmail={session.user.email}>
  <header class="admin-page-head compact admin-detail-head">
    <div>
      <p class="admin-kicker">Producto / opcion</p>
      <h1>{product.product_variants?.products?.name} {product.name}</h1>
      <p class="admin-note">{product.product_variants?.name} · {product.product_variants?.products?.categories?.name}</p>
      <p class:list={['admin-status', product.status]}>{product.status === 'published' ? 'Publicado' : 'Borrador'}</p>
      <p class="admin-detail-links">
        <a href="/admin/productos">Volver a productos</a>
        <a href={`/productos/${product.slug}`} target="_blank" rel="noreferrer">Ver publico -></a>
      </p>
    </div>
    <div class="admin-actions">
      <button class="admin-button" form="product-form" type="submit">Guardar informacion</button>
    </div>
  </header>

  {message && <p class="admin-success">{message}</p>}
  {errorMessage && <p class="admin-error">No se pudo guardar: {errorMessage}</p>}

  <section class="admin-panel pad">
    <form class="admin-form" id="product-form" method="post">
      <input type="hidden" name="intent" value="save-product" />
      <input type="hidden" name="csrf_token" value={csrfToken} />
      <div class="admin-form-grid">
        <div class="admin-field">
          <label for="name">Nombre acabado/opcion</label>
          <input id="name" name="name" value={product.name} required />
        </div>
        <div class="admin-field">
          <label for="slug">Slug publico</label>
          <input id="slug" name="slug" value={product.slug} required />
        </div>
        <div class="admin-field">
          <label for="sku">SKU</label>
          <input id="sku" name="sku" value={product.sku ?? ''} />
        </div>
        <div class="admin-field">
          <label for="price">Precio</label>
          <input id="price" name="price" type="number" min="0" step="0.01" value={product.price ?? 1} />
        </div>
        <div class="admin-field">
          <label for="status">Estado</label>
          <select id="status" name="status">
            <option value="draft" selected={product.status === 'draft'}>Borrador</option>
            <option value="published" selected={product.status === 'published'}>Publicado</option>
          </select>
        </div>
        <div class="admin-field">
          <label for="sort_order">Orden</label>
          <input id="sort_order" name="sort_order" type="number" value={product.sort_order} />
        </div>
        <div class="admin-field">
          <label for="featured">Destacado</label>
          <label><input id="featured" name="featured" type="checkbox" checked={product.featured} /> Mostrar como destacado</label>
        </div>
        <div class="admin-field full">
          <label for="summary">Resumen</label>
          <textarea id="summary" name="summary">{product.summary ?? ''}</textarea>
        </div>
        <div class="admin-field full">
          <label for="description">Descripcion</label>
          <textarea id="description" name="description">{product.description ?? ''}</textarea>
        </div>
        <div class="admin-field">
          <label for="color_name">Color</label>
          <input id="color_name" name="color_name" value={product.color_name ?? ''} />
        </div>
        <div class="admin-field">
          <label for="color_slug">Slug color</label>
          <input id="color_slug" name="color_slug" value={product.color_slug ?? ''} />
        </div>
        <div class="admin-field">
          <label for="color_hex">Hex color</label>
          <input id="color_hex" name="color_hex" value={product.color_hex ?? ''} placeholder="#000000" />
        </div>
        <div class="admin-field">
          <label for="finish">Acabado</label>
          <input id="finish" name="finish" value={product.finish ?? ''} />
        </div>
        <div class="admin-field">
          <label for="dimensions">Dimensiones</label>
          <input id="dimensions" name="dimensions" value={product.dimensions ?? ''} />
        </div>
        <div class="admin-field">
          <label for="thickness">Espesor</label>
          <input id="thickness" name="thickness" value={product.thickness ?? ''} />
        </div>
        <div class="admin-field">
          <label for="material">Material</label>
          <input id="material" name="material" value={product.material ?? ''} />
        </div>
        <div class="admin-field">
          <label for="usage">Uso</label>
          <input id="usage" name="usage" value={product.usage ?? ''} />
        </div>
        <div class="admin-field full">
          <label for="installation_notes">Instalacion</label>
          <textarea id="installation_notes" name="installation_notes">{product.installation_notes ?? ''}</textarea>
        </div>
        <div class="admin-field full">
          <label for="care_notes">Cuidados</label>
          <textarea id="care_notes" name="care_notes">{product.care_notes ?? ''}</textarea>
        </div>
        <div class="admin-field full">
          <label for="technical_specs">Datos técnicos adicionales (JSON)</label>
          <textarea id="technical_specs" name="technical_specs">{JSON.stringify(product.technical_specs ?? {}, null, 2)}</textarea>
        </div>
        <div class="admin-field">
          <label for="technical_sheet_url">Ficha técnica (Drive)</label>
          <input id="technical_sheet_url" name="technical_sheet_url" type="url" value={product.technical_sheet_url ?? ''} />
        </div>
        <div class="admin-field">
          <label for="installation_guide_url">Guía de instalación (Drive)</label>
          <input id="installation_guide_url" name="installation_guide_url" type="url" value={product.installation_guide_url ?? ''} />
        </div>
        <fieldset class="admin-field full">
          <legend>Visibilidad de secciones para este producto</legend>
          {(['technical', 'support', 'faq', 'installation'] as const).map((section) => (
            <label><input name={`show_${section}`} type="checkbox" checked={product.section_visibility?.[section] !== false} /> {section}</label>
          ))}
        </fieldset>
        <div class="admin-field">
          <label for="seo_title">SEO title</label>
          <input id="seo_title" name="seo_title" value={product.seo_title ?? ''} />
        </div>
        <div class="admin-field">
          <label for="canonical_path">Canonical path</label>
          <input id="canonical_path" name="canonical_path" value={product.canonical_path ?? ''} />
        </div>
        <div class="admin-field full">
          <label for="seo_description">SEO description</label>
          <textarea id="seo_description" name="seo_description">{product.seo_description ?? ''}</textarea>
        </div>
      </div>
      <button class="admin-button admin-mobile-save" type="submit">Guardar informacion</button>
    </form>
  </section>

  <section class="admin-panel pad admin-section-spaced">
    <div class="admin-topbar">
      <div>
        <p class="admin-kicker">Imagenes</p>
        <h2>Editar imagenes existentes</h2>
        <p class="admin-note">Esta primera version permite editar metadata y eliminar registros. La subida/reemplazo de archivos queda para el siguiente bloque.</p>
      </div>
    </div>

    <form class="admin-form" method="post">
      <input type="hidden" name="intent" value="save-images" />
      <input type="hidden" name="csrf_token" value={csrfToken} />
      <div class="admin-images">
        {images.map((image) => (
          <div class="admin-image-row">
            <img src={getPublicStorageUrl(image.storage_bucket, image.storage_path)} alt={image.alt_text ?? ''} />
            <div class="admin-form-grid">
              <input type="hidden" name="image_id" value={image.id} />
              <div class="admin-field full">
                <label for={`alt_text_${image.id}`}>Alt text</label>
                <input id={`alt_text_${image.id}`} name={`alt_text_${image.id}`} value={image.alt_text ?? ''} />
              </div>
              <div class="admin-field">
                <label for={`kind_${image.id}`}>Tipo</label>
                <select id={`kind_${image.id}`} name={`kind_${image.id}`}>
                  {['main', 'secondary', 'gallery', 'extra', 'technical'].map((kind) => (
                    <option value={kind} selected={image.kind === kind}>{kind}</option>
                  ))}
                </select>
              </div>
              <div class="admin-field">
                <label for={`sort_order_${image.id}`}>Orden</label>
                <input id={`sort_order_${image.id}`} name={`sort_order_${image.id}`} type="number" value={image.sort_order} />
              </div>
              <div class="admin-field full">
                <label>Ruta Storage</label>
                <input value={image.storage_path} readonly />
              </div>
            </div>
          </div>
        ))}
        {!images.length && <p class="admin-note">Este producto no tiene imagenes asociadas.</p>}
      </div>
      {images.length > 0 && <button class="admin-button" type="submit">Guardar imagenes</button>}
    </form>

    {images.length > 0 && (
      <div class="admin-images admin-stack-spaced">
        {images.map((image) => (
          <form class="admin-delete-form" method="post">
            <input type="hidden" name="intent" value="delete-image" />
            <input type="hidden" name="csrf_token" value={csrfToken} />
            <input type="hidden" name="image_id" value={image.id} />
            <label class="admin-danger-check">
              <input type="checkbox" required />
              Confirmo eliminar solo el registro de imagen. El archivo en Storage no se borra en esta version.
            </label>
            <button class="admin-button secondary" type="submit">Eliminar registro: {image.storage_path}</button>
          </form>
        ))}
      </div>
    )}
  </section>
</AdminLayout>
