---
import ProductGallery from '../../components/productos/ProductGallery.astro';
import { selectProductMedia, parseMediaMetadata } from '../../lib/productMedia';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminSession } from '../../lib/adminAuth';
import { createSupabaseServerClient } from '../../lib/supabaseServer';
import { getCsrfToken, validateCsrfToken } from '../../lib/adminSecurity';
import { contentModules, contentError, isUuid, parseContentForm, sectionLabels, productPlaceholderPath } from '../../lib/adminContent';
import TechnicalFields from '../../components/admin/TechnicalFields.astro';
import { getProductCalculator } from '../../lib/productCalculator';
import { cleanMediaQueue, uploadMedia, type MediaRow } from '../../lib/adminMedia';
import { getPublicStorageUrl } from '../../lib/supabase';
import { deleteSupportFile, uploadSupportFile, supportMetadata, selectTechnicalSupportFile, type SupportFileRow } from '../../lib/adminSupportFiles';
import { deleteLocationAgent, saveLocationAgent, type LocationAgentRow } from '../../lib/adminLocationAgents';

export const prerender = false;
const [section, routeId, extra] = (Astro.params.path ?? '').split('/').filter(Boolean);
const module = Object.hasOwn(contentModules, section ?? '') ? contentModules[section] : undefined;
if (!module || extra) return new Response('No encontrado', { status: 404 });
const session = await getAdminSession(Astro.request, Astro.cookies);
if (!session) return Astro.redirect('/admin/login');
const client = createSupabaseServerClient(Astro.request, Astro.cookies);
const csrf = getCsrfToken(Astro.cookies);
const base = `/admin/${section}`;
const isNew = routeId === 'nuevo' || routeId === 'nueva';
if (routeId && !isNew && !isUuid(routeId)) return new Response('No encontrado', { status: 404 });
const id = !isNew ? routeId : undefined;
let record: Record<string, unknown> = { status: 'draft', sort_order: 0, price: 1, fallback_image_path: productPlaceholderPath };
if (isNew && section === 'productos' && isUuid(Astro.url.searchParams.get('familia') ?? '')) record.variant_id = Astro.url.searchParams.get('familia');
if (isNew && section === 'variantes' && isUuid(Astro.url.searchParams.get('tipo') ?? '')) record.product_id = Astro.url.searchParams.get('tipo');
let errorMessage = '';
let warning = '';
let submitted: FormData | undefined;
if (id) {
  const loaded = await client.from(module.table).select('*').eq('id', id).maybeSingle();
  if (loaded.error) return new Response('No se pudo consultar Supabase.', { status: 503 });
  if (!loaded.data) return new Response('No encontrado', { status: 404 });
  record = loaded.data;
}
const supportVariantId = section === 'variantes' ? id : section === 'productos' && id && isUuid(String(record.variant_id ?? '')) ? String(record.variant_id) : undefined;

// Todas las escrituras usan la sesión del editor y las políticas RLS.
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    if (!validateCsrfToken(Astro.cookies, form)) throw new Error('El formulario expiró. Recarga la página.');
    const intent = String(form.get('intent') ?? 'save');
    if (intent === 'cleanup') {
      const pending = await cleanMediaQueue(client);
      if (pending) throw new Error(`Quedan ${pending} archivos pendientes. Reintenta la limpieza.`);
      return Astro.redirect(`${base}?saved=1`, 303);
    }
    if (!routeId) throw new Error('Acción no válida.');
    if (intent === 'save') {
      submitted = form;
      const values = parseContentForm(module, form, record);
      if (id && values.slug !== undefined && values.slug !== record.slug && form.get('confirm_slug') !== 'on') throw new Error('Confirma el cambio de slug: la URL anterior dejará de funcionar.');
      const saved = id ? await client.from(module.table).update(values).eq('id', id).select('id').single() : await client.from(module.table).insert(values).select('id').single();
      if (saved.error) throw new Error(contentError(saved.error));
      return Astro.redirect(`${base}/${saved.data.id}?saved=1`, 303);
    }
    if (!id) throw new Error('Guarda primero el contenido.');
    if (section === 'ubicaciones' && intent === 'agent-save') {
      await saveLocationAgent(client, id, form);
      return Astro.redirect(`${base}/${id}?saved=1#agentes`, 303);
    }
    if (section === 'ubicaciones' && intent === 'agent-delete') {
      if (form.get('confirm_agent_delete') !== 'on') throw new Error('Confirma la eliminacion del agente.');
      await deleteLocationAgent(client, id, String(form.get('agent_id') ?? ''));
      return Astro.redirect(`${base}/${id}?saved=1#agentes`, 303);
    }
    if (intent === 'technical-file-save') {
      if (!supportVariantId) throw new Error('Guarda primero la familia del acabado.');
      await selectTechnicalSupportFile(client, supportVariantId, String(form.get('technical_support_file_id') ?? ''));
      return Astro.redirect(`${base}/${id}?saved=1#documentos`, 303);
    }
    if (intent === 'support-upload') {
      if (!supportVariantId) throw new Error('El archivo debe asociarse a una familia válida.');
      await uploadSupportFile(client, supportVariantId, form);
      return Astro.redirect(`${base}/${id}?saved=1`, 303);
    }
    if (intent === 'support-delete') {
      if (!supportVariantId) throw new Error('Acción no válida.');
      if (form.get('confirm_support_delete') !== 'on') throw new Error('Confirma la eliminación del archivo.');
      await deleteSupportFile(client, String(form.get('support_id') ?? ''), supportVariantId);
      return Astro.redirect(`${base}/${id}?saved=1`, 303);
    }
    if (intent === 'support-save') {
      if (!supportVariantId) throw new Error('Acción no válida.');
      const updated = await client.from('product_support_files').update(supportMetadata(form)).eq('id', String(form.get('support_id') ?? '')).eq('variant_id', supportVariantId).select('id').single();
      if (updated.error) throw new Error(contentError(updated.error));
      return Astro.redirect(`${base}/${id}?saved=1`, 303);
    }
    if (intent === 'delete') {
      if (form.get('confirm_delete') !== 'on') throw new Error('Confirma la eliminación.');
      if (module.child) {
        const children = await client.from(module.child.table).select('id', { count: 'exact', head: true }).eq(module.child.key, id);
        if (children.error) throw new Error(contentError(children.error));
        if (children.count) throw new Error('Primero reasigna o elimina el contenido dependiente. También puedes dejar este registro en borrador.');
      }
      const cleanupPaths: string[] = [];
      if (module.media) {
        const media = await client.from(module.media.table).select('storage_path').eq(module.media.key, id);
        if (media.error) throw new Error(contentError(media.error));
        cleanupPaths.push(...(media.data ?? []).map(item => item.storage_path));
      }
      if (section === 'variantes') {
        const files = await client.from('product_support_files').select('storage_path').eq('variant_id', id);
        if (files.error) throw new Error(contentError(files.error));
        cleanupPaths.push(...(files.data ?? []).map(item => item.storage_path));
      }
      if (section === 'ubicaciones') {
        const agents = await client.from('location_agents').select('photo_path').eq('location_id', id);
        if (!agents.error) cleanupPaths.push(...(agents.data ?? []).map(item => item.photo_path).filter(Boolean));
      }
      const deleted = await client.from(module.table).delete().eq('id', id).select('id').single();
      if (deleted.error) throw new Error(contentError(deleted.error));
      if (cleanupPaths.length) await cleanMediaQueue(client, cleanupPaths).catch(() => undefined);
      return Astro.redirect(`${base}?saved=1`, 303);
    }
    if (!module.media) throw new Error('Acción no válida.');
    if (intent === 'upload') await uploadMedia(client, module, id, String(record.slug), form);
    else if (intent === 'image-save' || intent === 'image-delete') {
      const imageId = String(form.get('image_id') ?? '');
      if (!isUuid(imageId)) throw new Error('Imagen inválida.');
      if (intent === 'image-delete') {
        if (form.get('confirm_delete') !== 'on') throw new Error('Confirma la eliminación de la imagen.');
        const removed = await client.from(module.media.table).delete().eq('id', imageId).eq(module.media.key, id).select('id,storage_path').single();
        if (removed.error) throw new Error(contentError(removed.error));
        await cleanMediaQueue(client, [removed.data.storage_path]).catch(() => undefined);
      } else {
        const metadata = parseMediaMetadata(form, module.media.kinds);
        const updated = await client.from(module.media.table).update(metadata).eq('id', imageId).eq(module.media.key, id).select('id').single();
        if (updated.error) throw new Error(contentError(updated.error));
      }
    } else throw new Error('Acción no válida.');
    return Astro.redirect(`${base}/${id}?saved=1`, 303);
  } catch (error) {
    Astro.response.status = 400;
    errorMessage = error instanceof Error ? error.message : 'No se pudo completar la operación.';
  }
}

// Las visitas GET solo consultan la cola; la limpieza requiere POST con CSRF.
const cleanup = await client.from('media_cleanup_queue').select('id', { count: 'exact', head: true });
if (cleanup.error) warning = 'Aplica la migración pendiente del CMS para habilitar la limpieza de imágenes.';
else if (cleanup.count) warning = `${cleanup.count} archivos pendientes de limpieza en Storage.`;
const relations: Record<string, { id: string; label: string }[]> = {};
for (const field of module.fields.filter(field => field.relation)) {
  const related = contentModules[field.relation!];
  const result = await client.from(related.table).select('*').order('name').limit(1000);
  if (result.error) errorMessage = contentError(result.error);
  let families = new Map<string, string>();
  if (field.relation === 'variantes') {
    const parents = await client.from('products').select('id,name').limit(1000);
    if (parents.error) errorMessage = contentError(parents.error);
    families = new Map((parents.data ?? []).map(row => [row.id, row.name]));
  }
  relations[field.key] = (result.data ?? []).map(row => ({ id: row.id, label: `${families.get(row.product_id) ? families.get(row.product_id) + ' / ' : ''}${row.name} (${row.status === 'published' ? 'publicado' : 'borrador'})` }));
}
const rawPage = Number(Astro.url.searchParams.get('page'));
const page = Number.isSafeInteger(rawPage) && rawPage > 0 ? Math.min(rawPage, 100000) : 1;
const search = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 150);
const statusFilter = Astro.url.searchParams.get('status') ?? '';
let rows: Record<string, unknown>[] = [];
let total = 0;
if (!routeId) {
  let query = client.from(module.table).select('*', { count: 'exact' }).order('sort_order').order('id').range((page - 1) * 25, page * 25 - 1);
  if (search) query = query.ilike(module.titleKey, `%${search.replace(/[%_]/g, '\\$&')}%`);
  if (['draft', 'published'].includes(statusFilter)) query = query.eq('status', statusFilter);
  const result = await query;
  rows = result.data ?? []; total = result.count ?? 0;
  if (result.error) errorMessage = contentError(result.error);
}
let images: MediaRow[] = [];
if (id && module.media) {
  const result = await client.from(module.media.table).select('*').eq(module.media.key, id).order('sort_order').order('id');
  images = result.data ?? [];
  if (result.error) errorMessage = contentError(result.error);
}
let supportFiles: SupportFileRow[] = [];
if (id && supportVariantId) {
  const result = await client.from('product_support_files').select('id,title,storage_bucket,storage_path,original_filename,mime_type,size_bytes,sort_order,upload_state').eq('variant_id', supportVariantId).order('sort_order').order('id');
  supportFiles = (result.data ?? []) as SupportFileRow[];
  if (result.error) errorMessage = contentError(result.error);
}
let locationAgents: LocationAgentRow[] = [];
if (id && section === 'ubicaciones') {
  const result = await client.from('location_agents').select('id,location_id,name,phone,photo_bucket,photo_path,sort_order,status').eq('location_id', id).order('sort_order').order('name');
  locationAgents = (result.data ?? []) as LocationAgentRow[];
  if (result.error) errorMessage = contentError(result.error);
}
const value = (key: string) => submitted ? String(submitted.get(key) ?? '') : String(record[key] ?? '');
const checked = (key: string) => submitted ? submitted.get(key) === 'on' : record[key] === true;
const fieldValue = (key: string, type?: string) => submitted ? value(key) : type === 'json' ? JSON.stringify(record[key] ?? {}, null, 2) : type === 'lines' ? (Array.isArray(record[key]) ? (record[key] as string[]).join('\n') : '') : value(key);
const visibility = (record.section_visibility ?? {}) as Record<string, boolean>;
let familyContext: { technical_support_file_id: string | null; name: string; product_id: string; products: { name: string; slug: string } } | undefined;
let familyOptions: { id: string; name: string; slug: string; status: string; technical_sheet_url: string | null; installation_guide_url: string | null }[] = [];
if (section === 'productos' && record.variant_id) {
  const result = await client.from('product_variants').select('name,product_id,technical_support_file_id,products(name,slug)').eq('id', String(record.variant_id)).maybeSingle();
  if (result.error) errorMessage = contentError(result.error);
  familyContext = result.data as unknown as typeof familyContext;
}
if (id && section === 'variantes') {
  const result = await client.from('product_options').select('id,name,slug,status,technical_sheet_url,installation_guide_url').eq('variant_id', id).order('sort_order').order('name');
  familyOptions = result.data ?? [];
  if (result.error) errorMessage = contentError(result.error);
}
const calculator = section === 'productos' && familyContext ? getProductCalculator({
  name: `${familyContext.products.name} ${record.name ?? ''}`, slug: String(record.slug ?? ''),
  categorySlug: familyContext.products.slug, categoryName: familyContext.products.name, macroCategory: 'interior',
  dimensions: String(record.dimensions ?? ''), technicalSpecs: (record.technical_specs ?? {}) as Record<string, string | number | null>,
  variants: [{ name: familyContext.name, slug: '', colors: [] }]
}) : undefined;
const pageUrl = (number: number) => `${base}?${new URLSearchParams({ q: search, status: statusFilter, page: String(number) })}`;
const catalogSection = ['familias', 'variantes', 'productos'].includes(section);
const backUrl = section === 'productos' && record.variant_id ? `/admin/productos?familia=${record.variant_id}` : section === 'variantes' && record.product_id ? `/admin/productos?tipo=${record.product_id}` : catalogSection ? '/admin/productos' : base;
const selectedMedia = selectProductMedia(images);
const mainImage = selectedMedia.main;
const swatchImage = selectedMedia.swatch;
const toneUrl = swatchImage ? getPublicStorageUrl(swatchImage.storage_bucket, swatchImage.storage_path) : getPublicStorageUrl('site-media', String(record.fallback_image_path ?? ''));
const technicalSupportFileId = section === 'variantes' ? String(record.technical_support_file_id ?? '') : familyContext?.technical_support_file_id ?? '';
const galleryPreviewProduct = {
  name: String(record.name ?? ''), image: mainImage ? getPublicStorageUrl(mainImage.storage_bucket, mainImage.storage_path) : getPublicStorageUrl('site-media', String(record.fallback_image_path ?? '')),
  imageAlt: mainImage?.alt_text ?? String(record.name ?? ''),
  galleryImages: selectedMedia.gallery.map(image => ({ url: getPublicStorageUrl(image.storage_bucket, image.storage_path) ?? '', alt: image.alt_text ?? String(record.name ?? '') })),
  technicalSupportFileId,
  supportFiles: supportFiles.filter(file => file.upload_state === 'ready').map(file => ({ id: file.id, title: file.title, url: getPublicStorageUrl(file.storage_bucket, file.storage_path) ?? '', mimeType: file.mime_type }))
};
const selectedTechnicalFile = supportFiles.find(file => file.id === technicalSupportFileId && file.upload_state === 'ready');
const imageLabels: Record<string, string> = { main: 'Imagen principal / catálogo', swatch: 'Muestra para miniaturas de variantes / colores', secondary: 'Imagen secundaria / primera miniatura', gallery: 'Galería / producto instalado', extra: 'Fotografía adicional', technical: 'Imagen técnica / medidas (no PDF)', before: 'Antes', after: 'Después' };
const legacyDocuments = familyOptions.flatMap(option => [
  { name: option.name, title: 'Ficha técnica', url: option.technical_sheet_url },
  { name: option.name, title: 'Guía de instalación', url: option.installation_guide_url }
]).filter(item => item.url && /^https?:\/\//i.test(item.url));
const fieldGroups = section === 'productos' ? [
  { title: 'Identificación y familia', keys: ['name', 'variant_id', 'sku'] },
  { title: 'Información comercial y técnica', keys: ['price', 'summary', 'description', 'color_name', 'color_slug', 'color_hex', 'finish', 'dimensions', 'thickness', 'material', 'usage', 'technical_specs', 'faq_items', 'installation_notes', 'care_notes'] },
  { title: 'Publicación y SEO', keys: ['status', 'featured', 'sort_order', 'slug', 'seo_title', 'seo_description', 'canonical_path'] }
] : [{ title: 'Información', keys: module.fields.map(field => field.key) }];
---
<AdminLayout title={module.label} currentPath={base} userEmail={session.user.email}>
  <!-- Seccion: Encabezado y mensajes -->
  <header class="admin-page-head compact">
    <div><p class="admin-kicker">CMS / {module.label}</p><h1>{routeId ? isNew ? 'Nuevo registro' : String(record[module.titleKey]) : module.label}</h1>
      {catalogSection && <p class="admin-note">Tipo de producto → Familia / subcategoría → Acabado / color. Cada familia comparte sus PDF y agrupa únicamente sus propios colores.</p>}
    </div>
    <a class="admin-link-button" href={routeId ? backUrl : `${base}/${section === 'ubicaciones' ? 'nueva' : 'nuevo'}`}>{routeId ? 'Volver al listado' : 'Crear nuevo'}</a>
  </header>
  {Astro.url.searchParams.has('saved') && <p class="admin-success" role="status">Cambios guardados.</p>}
  {errorMessage && <p class="admin-error" role="alert">{errorMessage}</p>}
  {warning && <div class="admin-panel pad"><p role="status">{warning}</p><form method="post"><input type="hidden" name="csrf_token" value={csrf} /><button class="admin-button secondary" name="intent" value="cleanup">Reintentar limpieza</button></form></div>}
  {section === 'ubicaciones' && <p class="admin-note">El sitio conserva las dos ubicaciones locales como respaldo cuando no hay sucursales publicadas en Supabase. Publica una sucursal para que el sitio utilice el listado del CMS.</p>}
  {section === 'categorias' && <p class="admin-note">La navegación pública actual usa Interior y Exterior. Los accesorios son un tipo de producto dentro de esa estructura; crear otra categoría de uso no agrega automáticamente una pestaña al sitio.</p>}
  {!routeId ? <>
    <!-- Seccion: Listado -->
    <form class="admin-filters admin-panel" method="get">
      <input name="q" value={search} aria-label="Buscar por nombre" placeholder="Buscar por nombre" />
      <select name="status" aria-label="Estado"><option value="">Todos</option><option value="draft" selected={statusFilter === 'draft'}>Borrador</option><option value="published" selected={statusFilter === 'published'}>Publicado</option></select>
      <button class="admin-button">Buscar</button>
    </form>
    <section class="admin-panel pad" style="overflow-x:auto">
      <table class="admin-table"><thead><tr><th>Nombre</th><th>Estado</th><th>Orden</th><th>Acciones</th></tr></thead><tbody>
        {rows.map(row => <tr><td>{String(row[module.titleKey])}<br /><small>{String(row.slug ?? row.city ?? '')}</small></td><td>{row.status === 'published' ? 'Publicado' : 'Borrador'}</td><td>{String(row.sort_order)}</td><td><a href={`${base}/${row.id}`}>Editar →</a></td></tr>)}
        {!rows.length && <tr><td colspan="4">No hay registros para mostrar.</td></tr>}
      </tbody></table>
      <footer class="admin-pagination"><span>{total} registros</span>{page > 1 && <a href={pageUrl(page - 1)}>Anterior</a>}{page * 25 < total && <a href={pageUrl(page + 1)}>Siguiente</a>}</footer>
    </section>
  </> : <>
    <!-- Seccion: Edición de contenido -->
    <section class="admin-panel pad">
      {familyContext && <nav aria-label="Jerarquía del acabado"><a href="/admin/productos">Productos</a> → <a href={`/admin/productos?tipo=${familyContext.product_id}`}>{familyContext.products.name}</a> → <a href={`/admin/variantes/${record.variant_id}`}>{familyContext.name}</a> → {isNew ? 'Nuevo acabado / color' : String(record.name)}</nav>}
      {section === 'familias' && id && <p><a href={`/admin/productos?tipo=${id}`}>Ver familias de este tipo de producto →</a></p>}
      {section === 'variantes' && record.product_id && <nav aria-label="Jerarquía de la familia"><a href="/admin/productos">Productos</a> → <a href={`/admin/productos?tipo=${record.product_id}`}>{relations.product_id?.find(item => item.id === record.product_id)?.label ?? 'Tipo de producto'}</a> → {isNew ? 'Nueva familia' : String(record.name)}</nav>}
      {section === 'productos' && <p class="admin-note">Cada acabado puede tener una principal, una secundaria y una muestra independiente para los círculos de variantes. Sin muestra, se usa la principal. {id ? <a href="#imagenes">Revisar imágenes y muestra de color →</a> : 'Guarda primero el acabado para subir su imagen.'}</p>}
      {id && ['productos', 'proyectos'].includes(section) && <p><a href={`/${section}/${record.slug}`} target="_blank" rel="noreferrer">Ver página pública →</a> (los borradores devuelven 404)</p>}
      <form method="post" class="admin-form" data-content-form>
        <input type="hidden" name="csrf_token" value={csrf} /><input type="hidden" name="intent" value="save" />
        <div class="admin-form-grid">
          {fieldGroups.map(group => <fieldset class="admin-field full"><legend>{group.title}</legend><div class="admin-form-grid">{group.keys.map(key => module.fields.find(field => field.key === key)!).map(field => field.key === 'technical_specs' ? <TechnicalFields specs={(record.technical_specs ?? {}) as Record<string, unknown>} submitted={submitted} /> : <div class:list={['admin-field', ['textarea', 'json', 'lines'].includes(field.type ?? '') && 'full']}>
            <label for={field.key}>{field.label}</label>
            {field.hint && <small class="admin-note">{field.hint}</small>}
            {field.relation ? <><select id={field.key} name={field.key} required={field.required}><option value="">Selecciona…</option>{relations[field.key]?.map(item => <option value={item.id} selected={value(field.key) === item.id}>{item.label}</option>)}</select><a href={`/admin/${field.relation}`}>Administrar {contentModules[field.relation].label.toLowerCase()} →</a></>
              : field.choices ? <select id={field.key} name={field.key}>{field.choices.map(choice => <option value={choice} selected={value(field.key) === choice}>{choice === 'published' ? 'Publicado' : choice === 'draft' ? 'Borrador' : choice || 'Sin especificar'}</option>)}</select>
              : ['textarea', 'json', 'lines'].includes(field.type ?? '') ? <textarea id={field.key} name={field.key} required={field.required} rows={5}>{fieldValue(field.key, field.type)}</textarea>
              : field.type === 'checkbox' ? <input id={field.key} name={field.key} type="checkbox" checked={checked(field.key)} />
              : <input id={field.key} name={field.key} type={field.type === 'number' ? 'number' : field.type === 'url' ? 'url' : 'text'} value={value(field.key)} required={field.required} min={field.min} max={field.max} step={field.step} />}
          </div>)}</div></fieldset>)}
          {section === 'productos' && <fieldset class="admin-field full"><legend>Visibilidad individual de secciones</legend>{Object.entries(sectionLabels).map(([key, label]) => <label>{label}<select name={`section_${key}`}>{[['inherit', 'Heredar configuración global'], ['true', 'Mostrar'], ['false', 'Ocultar']].map(([option, title]) => <option value={option} selected={(submitted ? value(`section_${key}`) : visibility[key] === undefined ? 'inherit' : String(visibility[key])) === option}>{title}</option>)}</select></label>)}</fieldset>}
        </div>
        {id && record.slug && <label><input type="checkbox" name="confirm_slug" /> Confirmo cambiar la URL si modifiqué el slug.</label>}
        <button class="admin-button" type="submit">Guardar información</button><p data-save-status role="status"></p>
      </form>
    </section>
    {section === 'productos' && <section class="admin-panel pad admin-section-spaced"><h2>Calculadora según los datos guardados</h2>
      <p>{calculator?.mode === 'area' ? `Por área: ${calculator.coverage} m² por presentación.` : calculator?.mode === 'linear' ? `Por metros lineales: ${calculator.pieceLengthMeters} m por pieza.` : 'No se mostrará calculadora: este tipo está excluido o todavía no tiene rendimiento / longitud válidos.'}</p>
      {calculator && <p>{calculator.piecesPerPresentation ?? 1} piezas por presentación · {calculator.presentationLabel ?? 'Presentación no especificada'} · Sin merma añadida.</p>}
      <p class="admin-note">Guarda los cambios para actualizar este diagnóstico. La calculadora usa las mismas reglas que el sitio público.</p>
    </section>}
    {id && section === 'variantes' && <section class="admin-panel pad admin-section-spaced"><h2>Acabados de esta familia ({familyOptions.length})</h2><a class="admin-link-button" href={`/admin/productos/nuevo?familia=${id}`}>Añadir acabado</a>
      <ul>{familyOptions.map(option => <li><a href={`/admin/productos/${option.id}`}>{option.name}</a> — {option.status === 'published' ? 'Publicado' : 'Borrador'}</li>)}</ul>
      {!familyOptions.length && <p>Sin acabados. La familia aparecerá en el catálogo cuando tenga al menos un acabado publicado y sus padres estén publicados.</p>}
    </section>}
    {id && section === 'ubicaciones' && <section id="agentes" class="admin-panel pad admin-section-spaced">
      <h2>Agentes de venta</h2>
      <p>Estos agentes aparecen en la página pública de esta ubicación. Si no agregas agentes, el sitio mostrará un mensaje seguro sin romper el layout.</p>
      {locationAgents.map(agent => <article class="admin-image-row">
        {agent.photo_path ? <img src={getPublicStorageUrl(agent.photo_bucket ?? 'site-media', agent.photo_path)} alt={`Foto de ${agent.name}`} loading="lazy" /> : <div class="admin-image-placeholder">Sin foto</div>}
        <div><form method="post" enctype="multipart/form-data" class="admin-form">
          <input type="hidden" name="csrf_token" value={csrf} /><input type="hidden" name="agent_id" value={agent.id} />
          <label>Nombre<input name="agent_name" value={agent.name} required maxlength="160" /></label>
          <label>Teléfono<input name="agent_phone" value={agent.phone} required maxlength="60" /></label>
          <label>Estado<select name="agent_status"><option value="published" selected={agent.status === 'published'}>Publicado</option><option value="draft" selected={agent.status === 'draft'}>Borrador</option></select></label>
          <label>Orden<input name="agent_sort_order" type="number" step="1" value={agent.sort_order} required /></label>
          <label>Reemplazar foto<input type="file" name="agent_photo" accept="image/jpeg,image/png,image/webp" /></label>
          <button class="admin-button secondary" name="intent" value="agent-save">Guardar agente</button>
        </form><form method="post" class="admin-delete-form">
          <input type="hidden" name="csrf_token" value={csrf} /><input type="hidden" name="agent_id" value={agent.id} />
          <label><input type="checkbox" name="confirm_agent_delete" required /> Eliminar agente y foto</label><button class="admin-button secondary" name="intent" value="agent-delete">Eliminar</button>
        </form></div>
      </article>)}
      {!locationAgents.length && <p>Sin agentes registrados para esta ubicación.</p>}
      <form method="post" enctype="multipart/form-data" class="admin-form admin-section-spaced">
        <input type="hidden" name="csrf_token" value={csrf} />
        <h3>Agregar agente</h3><p>JPEG, PNG o WebP, máximo 4 MB. Se recorta a formato cuadrado.</p>
        <label>Nombre<input name="agent_name" required maxlength="160" /></label>
        <label>Teléfono<input name="agent_phone" required maxlength="60" /></label>
        <label>Foto<input type="file" name="agent_photo" accept="image/jpeg,image/png,image/webp" required /></label>
        <label>Estado<select name="agent_status"><option value="published">Publicado</option><option value="draft">Borrador</option></select></label>
        <label>Orden<input name="agent_sort_order" type="number" step="1" value="0" required /></label>
        <button class="admin-button" name="intent" value="agent-save">Agregar agente</button>
      </form>
    </section>}
    <!-- Seccion: Imágenes y Storage -->
    {module.media && id && <section id="imagenes" class="admin-panel pad admin-section-spaced">
      <h2>Imágenes{section === 'productos' ? ' y muestra del acabado / color' : ''}</h2>
      {section === 'productos' && <aside class="admin-image-guidance"><h3>Principal, muestra de color y secundaria</h3>
        <p>«Principal / catálogo» se muestra al abrir el producto y en su tarjeta. «Muestra para miniaturas de variantes / colores» se usa únicamente en los círculos de colores; si no la asignas, se usa la principal. «Secundaria» ocupa la primera miniatura bajo el visor; la ficha técnica seleccionada ocupa la segunda.</p>
        <p>Para cada uso se elige la imagen con menor orden. Si empatan, se usa el identificador para mantener el resultado estable. Las demás fotos se muestran después, ordenadas; las muestras de color no se agregan a la galería.</p>
        {toneUrl && <figure><div style="border-radius:50%;overflow:hidden;width:112px;height:112px"><img src={toneUrl} alt={`Vista previa del color ${record.name}`} style="object-fit:cover;width:100%;height:100%;transform:scale(5)" /></div><figcaption>Muestra efectiva en el selector de variantes.</figcaption></figure>}
        {!images.some(image => image.kind === 'main') && <p><strong>No hay principal asignada.</strong> Se usa la primera foto por orden o la imagen temporal.</p>}
      </aside>}
      {section !== 'productos' && <p>La principal con menor orden se usa como presentación. Las demás se ordenan por número e identificador.</p>}
      {images.map(image => <article class="admin-image-row">
        <img src={getPublicStorageUrl(image.storage_bucket, image.storage_path)} alt={image.alt_text ?? ''} loading="lazy" />
        <div><form method="post" class="admin-form">
          <input type="hidden" name="csrf_token" value={csrf} /><input type="hidden" name="image_id" value={image.id} />
          <label>Texto alternativo<input name="alt_text" value={image.alt_text ?? ''} /></label>
          {section === 'productos' && <p>{image.id === mainImage?.id && <strong>Principal efectiva. </strong>}{image.id === swatchImage?.id && <strong>Muestra de variante efectiva. </strong>}{image.id === selectedMedia.secondary?.id && <strong>Secundaria efectiva. </strong>}</p>}
          <label>Uso de la imagen<select name="kind">{module.media!.kinds.map(kind => <option value={kind} selected={image.kind === kind}>{imageLabels[kind]}</option>)}</select></label>
          <label>Orden<input name="sort_order" type="number" step="1" value={image.sort_order} required /></label>
          <button class="admin-button secondary" name="intent" value="image-save">Guardar imagen</button>
        </form><form method="post" class="admin-delete-form">
          <input type="hidden" name="csrf_token" value={csrf} /><input type="hidden" name="image_id" value={image.id} />
          <label><input type="checkbox" name="confirm_delete" required /> Eliminar imagen y archivo</label><button class="admin-button secondary" name="intent" value="image-delete">Eliminar</button>
        </form></div>
      </article>)}
      {!images.length && <div><p>Sin imagen real. {section === 'productos' ? 'Se utiliza la imagen temporal compartida del inventario; una imagen real tendrá prioridad.' : 'Añade una imagen principal.'}</p>{section === 'productos' && record.fallback_image_path && <img width="160" src={getPublicStorageUrl('site-media', String(record.fallback_image_path))} alt="Imagen temporal del catálogo" />}</div>}
      <form method="post" enctype="multipart/form-data" class="admin-form admin-section-spaced" data-upload-form>
        <input type="hidden" name="csrf_token" value={csrf} /><input type="hidden" name="intent" value="upload" />
        <h3>Subir o reemplazar imagen</h3><p>JPEG, PNG o WebP, máximo 4 MB. Se convierte a WebP y se reduce a 2400 px.</p>
        <label>Archivo<input type="file" name="file" accept="image/jpeg,image/png,image/webp" required /></label>
        <img data-upload-preview hidden alt="Vista previa del archivo seleccionado" width="200" />
        {section === 'productos' && <p class="admin-note">Elige el uso y el orden de la imagen. Para los círculos de variantes, sube una muestra cercana de color o textura. El PDF se selecciona en «Documentos de la familia», no como imagen técnica.</p>}
        <label>Reemplazar<select name="replace_id"><option value="">Añadir nueva imagen</option>{images.map(image => <option value={image.id}>{imageLabels[image.kind]} / {image.alt_text || image.storage_path}</option>)}</select></label>
        <label>Texto alternativo<input name="alt_text" required maxlength="1000" /></label>
        <label>Uso de la imagen<select name="kind">{module.media.kinds.map(kind => <option value={kind}>{imageLabels[kind]}</option>)}</select></label>
        <label>Orden<input name="sort_order" type="number" step="1" value="0" required /></label>
        <button class="admin-button" type="submit">Subir imagen</button><progress data-upload-progress hidden max="100" value="0"></progress><p data-upload-status role="status"></p>
      </form>
    </section>}
    {section === 'productos' && id && <section class="admin-panel pad admin-section-spaced"><h2>Vista previa de la galería guardada</h2><p>La vista previa usa las mismas reglas que el sitio. Guarda los cambios para actualizarla. La visibilidad individual y global de documentos se aplica en la página pública.</p><div class="admin-gallery-preview"><ProductGallery product={galleryPreviewProduct} /></div></section>}
    {id && supportVariantId && <section id="documentos" class="admin-panel pad admin-section-spaced">
      <h2>Documentos de la familia</h2>
      <p>Estos PDF y la selección de ficha técnica se comparten con TODOS los acabados de esta familia. Cambiarlos aquí también cambia los otros colores. El orden controla los documentos adicionales; la ficha técnica seleccionada siempre ocupa la segunda miniatura.</p>
      <form method="post" class="admin-form">
        <input type="hidden" name="csrf_token" value={csrf} /><input type="hidden" name="intent" value="technical-file-save" />
        <label>PDF que se mostrará como ficha técnica<select name="technical_support_file_id"><option value="">Sin ficha técnica en la galería</option>{supportFiles.filter(file => file.upload_state === 'ready').map(file => <option value={file.id} selected={technicalSupportFileId === file.id}>{file.title} — {file.original_filename}</option>)}</select></label>
        <button class="admin-button secondary">Guardar ficha técnica de la familia</button>
      </form>
      {selectedTechnicalFile && <iframe class="admin-document-preview" title="Vista previa de la ficha técnica seleccionada" src={`${getPublicStorageUrl(selectedTechnicalFile.storage_bucket, selectedTechnicalFile.storage_path)}#page=1&toolbar=0&navpanes=0&view=Fit`} loading="lazy"></iframe>}
      {legacyDocuments.length > 0 && <details><summary>Enlaces anteriores conservados ({legacyDocuments.length})</summary><p>Estos enlaces existían en acabados individuales. Se conservan como referencia para recuperar los documentos y subirlos aquí como PDF compartidos de la familia.</p><ul>{legacyDocuments.map(item => <li>{item.name}: <a href={item.url!} target="_blank" rel="noreferrer">{item.title}</a></li>)}</ul></details>}
      {supportFiles.map(file => <article class="admin-support-row">
        <div><strong>{file.title}</strong><br /><small>{file.original_filename} · {Math.ceil(file.size_bytes / 1024)} KB · {file.upload_state === 'pending' ? 'Subida incompleta: no visible en el sitio. Elimina este intento y vuelve a subir.' : 'Disponible para todos los acabados'}</small></div>
        <div>{file.upload_state === 'ready' && <a href={getPublicStorageUrl(file.storage_bucket, file.storage_path)} target="_blank" rel="noreferrer">Ver archivo</a>}
          <form method="post" class="admin-form"><input type="hidden" name="csrf_token" value={csrf} /><input type="hidden" name="support_id" value={file.id} /><label>Título<input name="support_title" value={file.title} required maxlength="160" /></label><label>Orden<input name="support_sort_order" type="number" value={file.sort_order} required step="1" /></label><button class="admin-button secondary" name="intent" value="support-save">Guardar título y orden</button></form>
          <form method="post" class="admin-delete-form"><input type="hidden" name="csrf_token" value={csrf} /><input type="hidden" name="support_id" value={file.id} /><label><input type="checkbox" name="confirm_support_delete" required /> Confirmo eliminar</label><button class="admin-button secondary" name="intent" value="support-delete">Eliminar</button></form>
        </div>
      </article>)}
      <form method="post" enctype="multipart/form-data" class="admin-form admin-section-spaced" data-support-upload>
        <input type="hidden" name="csrf_token" value={csrf} /><input type="hidden" name="intent" value="support-upload" />
        <input type="hidden" name="variant_id" value={supportVariantId} />
        <h3>Subir archivo de apoyo</h3><p>PDF, máximo 15 MB. Después de subirlo, selecciónalo arriba si debe aparecer como ficha técnica en la galería.</p>
        <label>Título<input name="support_title" value="Ficha técnica" required maxlength="160" /></label>
        <label>Archivo PDF<input type="file" name="support_file" accept="application/pdf,.pdf" required /></label>
        <label>Orden<input name="support_sort_order" type="number" step="1" value="0" required /></label>
        <button class="admin-button" type="submit">Subir archivo</button><progress data-support-progress hidden max="100" value="0"></progress><p data-support-status role="status"></p>
        <noscript>Sin JavaScript el límite es 4 MB. Actívalo para subir hasta 15 MB directamente a Storage.</noscript>
      </form>
    </section>}
    <!-- Seccion: Eliminación explícita -->
    {id && <section class="admin-panel pad admin-section-spaced"><h2>Eliminar registro</h2><p>La eliminación es permanente. Puedes usar el estado borrador para ocultarlo temporalmente.</p><form method="post" class="admin-form">
      <input type="hidden" name="csrf_token" value={csrf} /><label><input type="checkbox" name="confirm_delete" required /> Confirmo eliminar este registro y sus imágenes.</label><button class="admin-button secondary" name="intent" value="delete">Eliminar registro</button>
    </form></section>}
  </>}
</AdminLayout>
<script>
  import '../../scripts/adminForms';
</script>
