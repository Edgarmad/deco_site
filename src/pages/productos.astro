---
import '../styles/global.css';
import ProductMegaMenu from '../components/products/ProductMegaMenu.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import ProductCatalogPage from '../components/productos/ProductCatalogPage.astro';
import { getProductCategories, getProducts } from '../services/productService';

export const prerender = false;

const products = await getProducts();
const categories = await getProductCategories();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Catalogo Deco de revestimientos para interior y exterior." />
    <link rel="icon" href="/assets/favicon.ico" />
    <title>Productos | Deco</title>
  </head>
  <body>
    <SiteHeader currentPath="/productos" />
    <ProductMegaMenu categories={categories} />
    <ProductCatalogPage products={products} categories={categories} />

    <SiteFooter />
  </body>
</html>
