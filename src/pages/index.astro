---
import '../styles/global.css';

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Productos', href: '/productos' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Ubicaciones', href: '/ubicaciones' },
  { label: 'Contacto', href: '/contacto' }
];

const categories = [
  {
    number: '01',
    name: 'Interior',
    slug: 'interior',
    count: '20 productos',
    description: 'Paneles, lambrines y mármol sintético'
  },
  {
    number: '02',
    name: 'Exterior',
    slug: 'exterior',
    count: '10 productos',
    description: 'Lambrín extruido, deck y piedra sintética'
  }
];

const popularProducts = [
  { name: 'Deck para piso', slug: 'deck-para-piso', category: 'Exterior' },
  { name: 'Esquinero exterior', slug: 'esquinero-exterior', category: 'Exterior' },
  { name: 'Esquinero laminado', slug: 'esquinero-laminado', category: 'Interior' },
  { name: 'Tablero premium', slug: 'tablero-premium', category: 'Interior' },
  { name: 'Lambrín coextruido', slug: 'lambrin-coextruido', category: 'Exterior' },
  { name: 'Lambrín extruido', slug: 'lambrin-extruido', category: 'Exterior' },
  { name: 'Louver tech', slug: 'louver-tech', category: 'Interior' }
];

const locations = [
  ['01', 'Camcun', 'Bodega', 'Av Nacional 85, Col. Morelos, Quintana Roo, México'],
  ['02', 'Mérida', 'Tienda', 'Av Yucatán 586, Yucatán, México']
];

const projectItems = [
  {
    name: 'Expo CIHAC',
    slug: 'expo-cihac',
    type: 'Feria comercial',
    location: 'Ciudad de México',
    imageAlt: 'Muro de exhibición con paneles y recubrimientos iluminados en Expo CIHAC',
    visual: 'expo-cihac',
    chips: ['Panel lambrín laminado', 'Mármol sintético', 'Piedra sintética travertino', 'Viga coextruida']
  },
  {
    name: 'Proyecto AR Design',
    slug: 'proyecto-ar-design',
    type: 'Corporativo',
    location: 'Monterrey, Nuevo León',
    imageAlt: 'Interior corporativo con paneles verticales y puerta de vidrio texturizado',
    visual: 'ar-design',
    chips: ['Recubrimiento vinílico', 'Panel lambrín wavy', 'Piedra sintética PU', 'Panel SPC muros']
  },
  {
    name: 'Jeshi Ramen & Boba Tea',
    slug: 'jeshi-ramen-boba-tea',
    type: 'Comercial',
    location: 'San Pedro Garza García, N.L',
    imageAlt: 'Restaurante con lambrines, celosía azul y plafón decorativo',
    visual: 'jeshi-ramen',
    chips: ['Panel lambrín laminado', 'Mármol sintético']
  }
];

const initialProject = projectItems[0];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Deco, revestimientos premium para interiores, exteriores y proyectos arquitectónicos." />
    <title>Deco | Revestimientos Premium</title>
  </head>
  <body>
    <!-- Seccion: Header / Navegacion principal -->
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href="/" aria-label="Deco inicio">
          <span>DECO</span>
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>ABC</span>
        </a>
        <nav class="desktop-nav" aria-label="Navegación principal">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="header-actions" aria-label="Acciones rápidas">
          <a href="https://wa.me/" aria-label="WhatsApp">◔</a>
          <a href="/productos" aria-label="Buscar productos">⌕</a>
        </div>
      </div>
      <a class="calculator-strip" href="/contacto">
        Calcula tu material <span aria-hidden="true">→</span>
      </a>
    </header>

    <main id="inicio">
      <!-- Seccion: Hero principal -->
      <section class="hero" aria-label="Vista principal Deco">
        <video class="hero-video" autoplay muted loop playsinline preload="metadata" aria-label="Video principal de Deco">
          <source src="/assets/videos/header-hero.mp4" type="video/mp4" />
        </video>
      </section>

      <!-- Seccion: Compra por categoria -->
      <section id="productos" class="section categories-section">
        <div class="section-head">
          <a href="/productos">Compra por categoría</a>
          <span>30 productos en línea</span>
        </div>
        <div class="category-list">
          {categories.map((category) => (
            <article class="category-row">
              <span class="row-number">{category.number}</span>
              <h2>{category.name}</h2>
              <div class="row-meta">
                <strong>{category.count}</strong>
                <p>{category.description}</p>
              </div>
              <a class="round-button" href={`/productos?categoria=${category.slug}`} aria-label={`Ver ${category.name}`}>→</a>
            </article>
          ))}
        </div>
      </section>

      <!-- Seccion: Productos populares -->
      <section class="section popular-section" aria-labelledby="popular-title">
        <div class="product-strip" aria-label="Productos populares">
          {popularProducts.map((product, index) => (
            <a class="product-card" href={`/productos/${product.slug}`}>
              <div class={`product-form product-form-${index + 1}`} aria-hidden="true"></div>
              <span>{product.category}</span>
              <h3>{product.name}</h3>
            </a>
          ))}
        </div>
      </section>

      <!-- Seccion: Ubicaciones destacadas -->
      <section id="ubicaciones" class="dark-section locations-section">
        <div class="location-list">
          {locations.map(([number, city, type, address]) => (
            <article class="location-row">
              <span class="row-number">{number}</span>
              <h2>{city}</h2>
              <strong class={type === 'Tienda' ? 'tag filled' : 'tag'}>{type}</strong>
              <p>{address}</p>
              <a class="round-button dark" href="/ubicaciones" aria-label={`Ver ubicación ${city}`}>→</a>
            </article>
          ))}
        </div>
      </section>

      <!-- Seccion: Archivo de proyectos -->
      <section id="proyectos" class="dark-section projects-section">
        <div class="archive-label">Archivo de proyectos</div>
        <div class="projects-layout">
          <aside class="project-index" aria-label="Lista de proyectos">
            {projectItems.map((project, index) => (
              <button
                class={index === 0 ? 'active' : ''}
                type="button"
                data-project-index={index}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <span>{String(index + 1).padStart(2, '0')}</span>{project.name}
              </button>
            ))}
          </aside>
          <article class="project-feature" data-project-feature>
            <div
              class={`project-image project-image-${initialProject.visual}`}
              data-project-image
              role="img"
              aria-label={initialProject.imageAlt}
            ></div>
            <div class="project-card">
              <span data-project-type>{initialProject.type}</span>
              <h2 data-project-name>{initialProject.name}</h2>
              <p data-project-location>{initialProject.location}</p>
              <div class="chips" data-project-chips>
                {initialProject.chips.map((chip) => <small>{chip}</small>)}
              </div>
              <a data-project-link href={`/proyectos/${initialProject.slug}`}>Ver proyecto →</a>
            </div>
          </article>
        </div>
      </section>
    </main>

    <!-- Seccion: Interacciones de proyectos -->
    <script define:vars={{ projectItems }}>
      const projectButtons = document.querySelectorAll('[data-project-index]');
      const projectImage = document.querySelector('[data-project-image]');
      const projectType = document.querySelector('[data-project-type]');
      const projectName = document.querySelector('[data-project-name]');
      const projectLocation = document.querySelector('[data-project-location]');
      const projectChips = document.querySelector('[data-project-chips]');
      const projectLink = document.querySelector('[data-project-link]');

      const setActiveProject = (activeIndex) => {
        const project = projectItems[activeIndex];

        if (!project || !projectImage || !projectType || !projectName || !projectLocation || !projectChips || !projectLink) {
          return;
        }

        projectButtons.forEach((button, index) => {
          const isActive = index === activeIndex;
          button.classList.toggle('active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });

        projectImage.className = `project-image project-image-${project.visual}`;
        projectImage.setAttribute('aria-label', project.imageAlt);
        projectType.textContent = project.type;
        projectName.textContent = project.name;
        projectLocation.textContent = project.location;
        projectLink.href = `/proyectos/${project.slug}`;
        projectChips.replaceChildren(...project.chips.map((chip) => {
          const chipElement = document.createElement('small');
          chipElement.textContent = chip;
          return chipElement;
        }));
      };

      projectButtons.forEach((button) => {
        button.addEventListener('click', () => {
          setActiveProject(Number(button.dataset.projectIndex));
        });
      });
    </script>

    <!-- Seccion: Footer / Enlaces de apoyo -->
    <footer class="site-footer">
      <div class="footer-title">Innovative <em>ideas,</em><br /> inspired <em>living</em></div>
      <div class="footer-grid">
        <nav aria-label="Explora">
          <h2>/Explora</h2>
          <a href="/ubicaciones">Ubicaciones</a>
          <a href="/productos">Catálogo</a>
          <a href="/contacto">Contacto</a>
        </nav>
        <nav aria-label="Productos populares">
          <h2>/Productos populares</h2>
          {popularProducts.slice(0, 4).map((product) => <a href={`/productos/${product.slug}`}>{product.name}</a>)}
        </nav>
        <div>
          <h2>/Asistencia</h2>
          <a href="/contacto">Contacto</a>
          <p>Teléfono: (81) 2351 2953</p>
          <form class="feedback-form">
            <label for="feedback">¿Quejas o sugerencias?</label>
            <input id="feedback" type="email" placeholder="atencion@decotech.mx" />
          </form>
        </div>
      </div>
    </footer>
  </body>
</html>
