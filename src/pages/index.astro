---
import '../styles/global.css';

const navItems = ['Inicio', 'Productos', 'Proyectos', 'Ubicaciones', 'Deco Rewards'];

const categories = [
  {
    number: '01',
    name: 'Interior',
    count: '20 productos',
    description: 'Paneles, lambrines y mármol sintético'
  },
  {
    number: '02',
    name: 'Exterior',
    count: '10 productos',
    description: 'Lambrín extruido, deck y piedra sintética'
  }
];

const products = [
  'Deck para piso',
  'Esquinero exterior',
  'Esquinero laminado',
  'Tablero premium',
  'Lambrín coextruido',
  'Lambrín extruido',
  'Louver tech'
];

const locations = [
  ['01', 'Nuevo León', 'Bodega', 'C. Multitech 2 Ote. 103, Santa Catarina, Nuevo León, México'],
  ['02', 'Jalisco', 'Bodega', 'C. Hernán Cortés 6935-3, Zapopan, Jalisco, México'],
  ['03', 'Estado de México', 'Bodega', 'Calle Calz. de la Naranja 166, Naucalpan de Juárez, México'],
  ['04', 'Puebla', 'Bodega', 'Av Nacional 5572, Col. Ángeles Mayorazgo, Puebla, México'],
  ['05', 'Yucatán', 'Tienda', 'Av Yucatán 586, Mérida, Yucatán, México']
];

const projectItems = ['Expo CIHAC', 'Proyecto AR Design', 'Jeshi Ramen & Boba Tea', 'Gimnasio Volt', 'Hospital Delta', 'Estética Bella & Bestia', 'Residencia'];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Deco, revestimientos premium para interiores, exteriores y proyectos arquitectónicos." />
    <title>Deco | Revestimientos Premium</title>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href="#inicio" aria-label="Deco inicio">
          <span>DECO</span>
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>TECH</span>
        </a>
        <nav class="desktop-nav" aria-label="Navegación principal">
          {navItems.map((item) => <a href={`#${item.toLowerCase().replaceAll(' ', '-')}`}>{item}</a>)}
        </nav>
        <div class="header-actions" aria-label="Acciones rápidas">
          <a href="https://wa.me/" aria-label="WhatsApp">◔</a>
          <a href="#productos" aria-label="Buscar">⌕</a>
        </div>
      </div>
      <a class="calculator-strip" href="#productos">
        Calcula tu material y visualízalo en tu espacio <span aria-hidden="true">→</span>
      </a>
    </header>

    <main id="inicio">
      <section class="hero" aria-label="Vista principal Deco">
        <div class="hero-surface" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
      </section>

      <section id="productos" class="section categories-section">
        <div class="section-head">
          <a href="#productos">Compra por categoría</a>
          <span>30 productos en línea</span>
        </div>
        <div class="category-list">
          {categories.map((category) => (
            <article class="category-row">
              <span class="row-number">{category.number}</span>
              <h2>{category.name}</h2>
              <div class="row-meta">
                <strong>{category.count}</strong>
                <p>{category.description}</p>
              </div>
              <a class="round-button" href="#productos" aria-label={`Ver ${category.name}`}>→</a>
            </article>
          ))}
        </div>
        <div class="product-strip" aria-label="Productos destacados">
          {products.map((product, index) => (
            <article class="product-card">
              <div class={`product-form product-form-${index + 1}`} aria-hidden="true"></div>
              <h3>{product}</h3>
            </article>
          ))}
        </div>
      </section>

      <section id="ubicaciones" class="dark-section locations-section">
        <div class="location-list">
          {locations.map(([number, state, type, address]) => (
            <article class="location-row">
              <span class="row-number">{number}</span>
              <h2>{state}</h2>
              <strong class={type === 'Tienda' ? 'tag filled' : 'tag'}>{type}</strong>
              <p>{address}</p>
              <a class="round-button dark" href="#ubicaciones" aria-label={`Ver ubicación ${state}`}>→</a>
            </article>
          ))}
        </div>
      </section>

      <section id="proyectos" class="dark-section projects-section">
        <div class="archive-label">Archivo de proyectos</div>
        <div class="projects-layout">
          <aside class="project-index" aria-label="Lista de proyectos">
            {projectItems.map((item, index) => (
              <a class={index === 0 ? 'active' : ''} href="#proyectos">
                <span>{String(index + 1).padStart(2, '0')}</span>{item}
              </a>
            ))}
          </aside>
          <article class="project-feature">
            <div class="project-wall" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>
            <div class="project-card">
              <span>Feria comercial</span>
              <h2>Expo CIHAC</h2>
              <p>Ciudad de México</p>
              <div class="chips">
                <small>Panel lambrín laminado</small>
                <small>Mármol sintético</small>
                <small>Piedra travertino</small>
              </div>
              <a href="#proyectos">Ver proyecto →</a>
            </div>
          </article>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-title">Innovative <em>ideas,</em><br /> inspired <em>living</em></div>
      <div class="footer-grid">
        <nav aria-label="Explora">
          <h2>/Explora</h2>
          <a href="#ubicaciones">Ubicaciones</a>
          <a href="#productos">Catálogo</a>
          <a href="#inicio">Sobre nosotros</a>
        </nav>
        <nav aria-label="Productos populares">
          <h2>/Productos populares</h2>
          <a href="#productos">Esquinero laminado</a>
          <a href="#productos">Perfil aluminio</a>
          <a href="#productos">Recubrimiento vinílico</a>
          <a href="#productos">Panel lambrín wavy</a>
        </nav>
        <div>
          <h2>/Asistencia</h2>
          <a href="mailto:atencion@decotech.mx">Contacto</a>
          <p>Teléfono: (81) 2351 2953</p>
          <form class="feedback-form">
            <label for="feedback">¿Quejas o sugerencias?</label>
            <input id="feedback" type="email" placeholder="atencion@decotech.mx" />
          </form>
        </div>
      </div>
    </footer>
  </body>
</html>
