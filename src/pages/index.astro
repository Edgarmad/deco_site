---
import '../styles/global.css';
import CategoriesSection from '../components/index/CategoriesSection.astro';
import HeroSection from '../components/index/HeroSection.astro';
import LocationsSection from '../components/index/LocationsSection.astro';
import PopularProductsSection from '../components/index/PopularProductsSection.astro';
import ProjectsArchiveSection from '../components/index/ProjectsArchiveSection.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { getProducts } from '../services/productService';

const products = await getProducts();

const categories = [
  {
    name: 'Interior',
    slug: 'interior',
    count: '20 productos',
    description: 'Paneles, lambrines y mármol sintético'
  },
  {
    name: 'Exterior',
    slug: 'exterior',
    count: '10 productos',
    description: 'Lambrín extruido, deck y piedra sintética'
  }
];

const popularProducts = Array.from(
  products.reduce((items, product) => {
    const key = product.categorySlug || product.slug;
    if (!items.has(key)) {
      items.set(key, {
        name: product.categoryName ?? product.name,
        slug: product.slug,
        category: product.macroCategory === 'exterior' ? 'Exterior' : 'Interior',
        image: product.secondaryImage ?? product.image
      });
    }
    return items;
  }, new Map<string, { name: string; slug: string; category: string; image?: string }>()).values()
).slice(0, 7);

const locations = [
  {
    number: '01',
    city: 'Mérida',
    type: 'Tienda',
    address: 'Bodega 10, C. 6, Chichí Suárez, 97306',
    mapsUrl: 'https://maps.app.goo.gl/FG9PJTLZq6gDspWSA?g_st=ic',
    contact: '+52 999 000 0000'
  },
  {
    number: '02',
    city: 'Playa del Carmen',
    type: 'Tienda',
    address: 'Carretera Federal Mz 2 Lt 22, Bodega 7, entre calle 80 Norte y 88 Norte',
    mapsUrl: 'https://maps.app.goo.gl/7WJnTuYAhmoqoA5QA?g_st=ic',
    contact: '+52 984 000 0000'
  }
];

const projectItems = [
  {
    name: 'Expo CIHAC',
    slug: 'expo-cihac',
    type: 'Feria comercial',
    location: 'Ciudad de México',
    imageAlt: 'Muro de exhibición con paneles y recubrimientos iluminados en Expo CIHAC',
    visual: 'expo-cihac',
    chips: ['Panel lambrín laminado', 'Mármol sintético', 'Piedra sintética travertino', 'Viga coextruida']
  },
  {
    name: 'Proyecto AR Design',
    slug: 'proyecto-ar-design',
    type: 'Corporativo',
    location: 'Monterrey, Nuevo León',
    imageAlt: 'Interior corporativo con paneles verticales y puerta de vidrio texturizado',
    visual: 'ar-design',
    chips: ['Recubrimiento vinílico', 'Panel lambrín wavy', 'Piedra sintética PU', 'Panel SPC muros']
  },
  {
    name: 'Jeshi Ramen & Boba Tea',
    slug: 'jeshi-ramen-boba-tea',
    type: 'Comercial',
    location: 'San Pedro Garza García, N.L',
    imageAlt: 'Restaurante con lambrines, celosía azul y plafón decorativo',
    visual: 'jeshi-ramen',
    chips: ['Panel lambrín laminado', 'Mármol sintético']
  }
];

---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Deco, revestimientos premium para interiores, exteriores y proyectos arquitectónicos." />
    <link rel="icon" href="/assets/favicon.ico" />
    <script src="/assets/scripts/deco-motion.js" defer></script>
    <title>Deco | Revestimientos Premium</title>
  </head>
  <body>
    <SiteHeader currentPath="/" />
    <a class="calculator-strip" href="/contacto">
      Calcula tu material <span aria-hidden="true">→</span>
    </a>

    <main id="inicio">
      <HeroSection />
      <CategoriesSection categories={categories} />
      <PopularProductsSection products={popularProducts} />
      <LocationsSection locations={locations} />
      <ProjectsArchiveSection projectItems={projectItems} />
    </main>

    <SiteFooter />
  </body>
</html>
