---
import '../styles/global.css';
import CategoriesSection from '../components/index/CategoriesSection.astro';
import HeroSection from '../components/index/HeroSection.astro';
import LocationsSection from '../components/index/LocationsSection.astro';
import PopularProductsSection from '../components/index/PopularProductsSection.astro';
import ProjectsArchiveSection from '../components/index/ProjectsArchiveSection.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { getProducts, getProductCategories } from '../services/productService';
import { getLocations } from '../services/locationService';
import { getProjects } from '../services/projectService';

export const prerender = false;
const [products, cmsCategories, cmsLocations, cmsProjects] = await Promise.all([getProducts(), getProductCategories(), getLocations(), getProjects()]);

const categories = cmsCategories.map(category => ({ name: category.name, slug: category.slug, macroCategory: category.macroCategory, description: category.description ?? '', count: `${products.filter(product => product.macroCategory === category.macroCategory).length} productos` }));

const popularProducts = Array.from(
  products.reduce((items, product) => {
    const key = product.categorySlug || product.slug;
    if (!items.has(key)) {
      items.set(key, {
        name: product.categoryName ?? product.name,
        slug: product.slug,
        category: cmsCategories.find(category => category.slug === product.macroCategory)?.name ?? product.macroCategory,
        image: product.secondaryImage ?? product.image
      });
    }
    return items;
  }, new Map<string, { name: string; slug: string; category: string; image?: string }>()).values()
).slice(0, 7);

const locations = cmsLocations.map(location => ({ ...location, contact: location.phone ?? '' }));
const projectItems = cmsProjects.map(project => ({ ...project, type: project.category, chips: project.materials }));

---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Deco, revestimientos premium para interiores, exteriores y proyectos arquitectónicos." />
    <link rel="icon" href="/assets/favicon.ico" />
    <script src="/assets/scripts/deco-motion.js" defer></script>
    <title>Deco | Revestimientos Premium</title>
  </head>
  <body>
    <SiteHeader currentPath="/" />
    <a class="calculator-strip" href="/contacto">
      Calcula tu material <span aria-hidden="true">→</span>
    </a>

    <main id="inicio">
      <HeroSection />
      <CategoriesSection categories={categories} />
      <PopularProductsSection products={popularProducts} />
      <LocationsSection locations={locations} />
      <ProjectsArchiveSection projectItems={projectItems} />
    </main>

    <SiteFooter />
  </body>
</html>
