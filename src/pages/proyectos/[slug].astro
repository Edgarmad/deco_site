---
import '../../styles/global.css';
import ProjectDetailPage from '../../components/projects/ProjectDetailPage.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import { getProjects } from '../../services/projectService';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={project.description} />
    <link rel="icon" href="/assets/favicon.ico" />
    <title>{project.name} | Proyectos Deco ABC</title>
  </head>
  <body>
    <SiteHeader currentPath="/proyectos" />
    <ProjectDetailPage project={project} />
    <SiteFooter />
  </body>
</html>
