---
import '../../styles/global.css';
import ProjectDetailPage from '../../components/projects/ProjectDetailPage.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import { getProjectBySlug } from '../../services/projectService';

export const prerender = false;

const { slug } = Astro.params;
const project = slug ? await getProjectBySlug(slug) : undefined;
if (!project) return new Response(null, { status: 404 });
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={project.seoDescription ?? project.description} />
    <link rel="canonical" href={new URL(`/proyectos/${project.slug}`, Astro.url.origin).href} />
    <meta property="og:title" content={project.seoTitle ?? project.name} />
    <meta property="og:description" content={project.seoDescription ?? project.description} />
    {project.image && <meta property="og:image" content={project.image} />}
    <link rel="icon" href="/assets/favicon.ico" />
    <script src="/assets/scripts/deco-motion.js" defer></script>
    <title>{project.seoTitle ?? `${project.name} | Proyectos Deco ABC`}</title>
  </head>
  <body>
    <SiteHeader currentPath="/proyectos" />
    <ProjectDetailPage project={project} />
    <SiteFooter />
  </body>
</html>
