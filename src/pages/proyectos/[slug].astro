---
import '../../styles/global.css';
import ProjectDetailPage from '../../components/projects/ProjectDetailPage.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import { getProjectBySlug } from '../../services/projectService';

export const prerender = false;

const { slug } = Astro.params;
const project = slug ? await getProjectBySlug(slug) : undefined;
if (!project) return new Response(null, { status: 404 });
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={project.description} />
    <link rel="icon" href="/assets/favicon.ico" />
    <title>{project.name} | Proyectos Deco ABC</title>
  </head>
  <body>
    <SiteHeader currentPath="/proyectos" />
    <ProjectDetailPage project={project} />
    <SiteFooter />
  </body>
</html>
