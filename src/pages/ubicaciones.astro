---
import '../styles/global.css';
import LocationsPage from '../components/locations/LocationsPage.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { getLocations } from '../services/locationService';
import { getWhatsappUrl } from '../services/siteSettingsService';

export const prerender = false;

const locations = await getLocations();
const whatsappUrl = await getWhatsappUrl();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Ubicaciones Deco ABC en Mérida y Playa del Carmen para atención directa de proyectos." />
    <link rel="icon" href="/assets/favicon.ico" />
    <script src="/assets/scripts/deco-motion.js" defer></script>
    <title>Ubicaciones | Deco ABC</title>
  </head>
  <body>
    <SiteHeader currentPath="/ubicaciones" />
    <LocationsPage locations={locations} whatsappUrl={whatsappUrl} />
    <SiteFooter />
  </body>
</html>
