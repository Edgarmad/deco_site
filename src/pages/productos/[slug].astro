---
import '../../styles/global.css';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import ProductDetailPage from '../../components/productos/ProductDetailPage.astro';
import { getProductCategories, getProducts } from '../../services/productService';

export const getStaticPaths = async () => {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
};

const { product } = Astro.props;
const categories = await getProductCategories();
const products = await getProducts();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={product.summary ?? `Detalle de ${product.name} en Deco.`} />
    <link rel="icon" href="/assets/favicon.ico" />
    <title>{product.name} | Deco</title>
  </head>
  <body>
    <SiteHeader currentPath="/productos" />
    <ProductDetailPage product={product} categories={categories} products={products} />

    <SiteFooter />
  </body>
</html>
