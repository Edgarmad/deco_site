---
import '../../styles/global.css';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import ProductDetailPage from '../../components/productos/ProductDetailPage.astro';
import { getProductBySlug, getProductCategories, getProducts } from '../../services/productService';
import { getProductSectionVisibility } from '../../services/siteSettingsService';

export const prerender = false;

const { slug } = Astro.params;
const product = slug ? await getProductBySlug(slug) : undefined;
if (!product) return new Response(null, { status: 404 });
const categories = await getProductCategories();
const products = await getProducts();
const sectionVisibility = await getProductSectionVisibility();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={product.seoDescription ?? product.summary ?? `Detalle de ${product.name} en Deco.`} />
    <link rel="canonical" href={new URL(product.canonicalPath ?? `/productos/${product.slug}`, Astro.url.origin).href} />
    <meta property="og:title" content={product.seoTitle ?? product.name} />
    <meta property="og:description" content={product.seoDescription ?? product.summary} />
    {product.image && <meta property="og:image" content={product.image} />}
    <link rel="icon" href="/assets/favicon.ico" />
    <script src="/assets/scripts/deco-motion.js" defer></script>
    <title>{product.seoTitle ?? `${product.name} | Deco`}</title>
  </head>
  <body>
    <SiteHeader currentPath="/productos" />
    <ProductDetailPage product={product} categories={categories} products={products} sectionVisibility={sectionVisibility} />

    <SiteFooter />
  </body>
</html>
